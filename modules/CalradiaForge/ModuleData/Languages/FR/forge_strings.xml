"Attention" /><string id="forge_794131b64bc2" text="Laboratoire de relecture" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="Saisissez une séquence d’événement conservée, puis lancez une relecture protégée." /><string id="forge_c8dae6371b33" text="Relecture" /><string id="forge_2d1e82553a41" text="Source de la relecture" /><string id="forge_6b7609616c31" text="Résultat de la relecture" /><string id="forge_ae02ff4ee2da" text="Mode de relecture" /><string id="forge_274844a2a9d7" text="Relecture refusée" /><string id="forge_ab9b00d2d398" text="Relecture terminée" /><string id="forge_19bc07d10e98" text="Sélectionnez une séquence d’événement conservée." /><string id="forge_63bfa59d261f" text="Aucun événement conservé n’est disponible." /><string id="forge_c490ac762d13" text="La relecture en direct réutilise les protections existantes du mode test et de la copie de campagne." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="Analyse uniquement l’assembly indiqué et enregistre les contrats SDK pris en charge." /><string id="forge_ec2d15a6c2b8" text="Déclare un prefab Gauntlet autonome que Forge peut ouvrir dans une couche." /><string id="forge_4891dad02563" text="Déclare une commande Gauntlet sans paramètre et son contexte requis." /><string id="forge_0f22b4474d14" text="Demande à l’hôte Forge d’ouvrir une page d’extension enregistrée." /><string id="forge_a105da0e865c" text="Lit des métadonnées PE/.NET limitées en arrière-plan sans charger ni exécuter la DLL. Les changements de version nécessitent un aperçu et créent une copie vérifiée avec sauvegarde et empreintes." /><string id="forge_ed668f618580" text="Les attributs valident les métadonnées, sans isoler le code tiers. Les commandes restent le code de l’auteur et doivent respecter les règles de thread principal de Bannerlord." /><string id="forge_7398a2596036" text="Chemin de l’assembly ou index" /><string id="forge_dd167905de0d" text="Version" /><string id="forge_2ba785b2d3a4" text="Lister les DLL installées" /><string id="forge_7d09a0fdc74d" text="Sélectionner la ligne DLL" /><string id="forge_26c48e56ad62" text="Inspecter les métadonnées" /><string id="forge_ef91046c4294" text="Aperçu de version" /><string id="forge_dbd8f023eda9" text="Appliquer à une copie" /><string id="forge_0eac5d3fd9da" text="Atelier d’assemblies" /><string id="forge_395b1be558b8" text="Ouvrir la page d’extension" /><string id="forge_a1155cbb1daf" text="Aide contextuelle" /><string id="forge_789588bda2aa" text="Pages d’extension Gauntlet" /><string id="forge_b672f9bf0dab" text="Saisissez l’ID d’une page dans le champ d’argument, puis choisissez Ouvrir la page d’extension." /><string id="forge_32eaf5cf96d5" text="Utilisez l’aide contextuelle pour les conseils SDK hors ligne et l’atelier d’assemblies." /><string id="forge_346f06362ca2" text="Guide de l’atelier d’assemblies" /><string id="forge_0a10143c886e" text="Listez les DLL installées, saisissez un numéro de ligne et sélectionnez-la. L’inspection lit uniquement les métadonnées PE, sans charger ni exécuter le fichier." /><string id="forge_c0287b2759d7" text="Pour changer la version, saisissez quatre composants, prévisualisez d’abord puis appliquez pour créer une copie dans LocalAppData/CalradiaForge/AssemblyWorkbench." /><string id="forge_a75050e56e7d" text="Les assemblies signés strong name et mixtes sont refusés. L’original est conservé ; une sauvegarde source et des preuves SHA-256 sont enregistrées." /><string id="forge_a2256b564db1" text="Aide SDK en jeu" /><string id="forge_b5911a953b0d" text="Aucune ligne correspondante trouvée." /><string id="forge_dd3b39dacbf7" text="SDK AVANCÉ" /><string id="forge_f3bccf3efbfe" text="L’audit du manifeste audio est terminé." /><string id="forge_ee88528b0625" text="Le test audio a été exécuté." /><string id="forge_153f0a2d00cb" text="Parcourir les plus de 110 outils avancés du SDK" /><string id="forge_04fb89acf8ae" text="HISTORIQUE DES COMMANDES" /><string id="forge_1671fd14dfa5" text="L’évaluation du casus belli est terminée." /><string id="forge_9768be40e931" text="Effacer l’historique" /><string id="forge_4e6e062d6524" text="Efface tout l’historique des commandes enregistré." /><string id="forge_729f0343c990" text="Ferme le catalogue SDK." /><string id="forge_af09632242f3" text="Copié dans le presse-papiers." /><string id="forge_1a5b5a6ad016" text="La simulation du crime et de la pègre est terminée." /><string id="forge_75a51e1c4583" text="Ctrl+F : saisie · Ctrl+Enter : actualiser la sortie" /><string id="forge_4e62272d6dc1" text="Ctrl+K : aide · Ctrl+W : surveillance · Tab : focus" /><string id="forge_1b497f9d7f85" text="L’évaluation de la dynastie et de la succession est terminée." /><string id="forge_b13945c508a8" text="Filtre effacé. Toutes les lignes sont affichées." /><string id="forge_055819ab7f57" text="Filtre appliqué : {0} lignes correspondantes." /><string id="forge_50ce67c7fc43" text="Mémoire nettoyée : {0:F1} Mo récupérés" /><string id="forge_6583c717f13e" text="Historique ▾" /><string id="forge_582f2cd9b20f" text="Surveillance en direct activée (intervalle de 1 s)" /><string id="forge_2d559fafb5c2" text="Surveillance en direct désactivée" /><string id="forge_2780abe560d2" text="Charge la commande suivante de l’historique (flèche bas)." /><string id="forge_ed8b52d5e5c7" text="Charge la commande précédente de l’historique (flèche haut)." /><string id="forge_1c4c3d2a6aab" text="L’audit de localisation est terminé." /><string id="forge_f5b3e708c545" text="Ouvre le catalogue consultable des outils avancés du SDK." /><string id="forge_0acff9a2de67" text="L’affichage de la sortie a été effacé." /><string id="forge_298d79d4c832" text="La simulation de groupe est terminée." /><string id="forge_66a024aea84a" text="Catalogue SDK" /><string id="forge_50e8fa699d85" text="Le contrôle de l’état des sauvegardes a réussi." /><string id="forge_f4b0f74fd12a" text="Le squelette a été généré. Utilisez Copier dans le presse-papiers pour l’enregistrer." /><string id="forge_fb69d1d9a74d" text="L’analyse des tactiques de siège est terminée." /><string id="forge_78d49d020849" text="Affiche ou masque la liste déroulante de l’historique récent des commandes." /><string id="forge_a006eefe667b" text="Affiche ou masque le guide tactique des raccourcis clavier (Ctrl+K)." /><string id="forge_c5de2e25402f" text="La simulation commerciale est terminée." /><string id="forge_05d04cc462be" text="[ ⌨ Touches ]" /><string id="forge_71886b7929d2" text="Filtrer la sortie actuelle sans modifier le paramètre de l'outil." /><string id="forge_f5b680c59d2d" text="Filtrer les lignes de sortie..." /><string id="forge_d03ed87a54bf" text="Effacer le filtre de sortie." /><string id="forge_c6ece04535b2" text="Aucune ligne de sortie ne correspond à ce filtre." /><string id="forge_03867aea70ac" text="Preuves" /><string id="forge_78f6584233f0" text="Épingler la sortie de référence" /><string id="forge_11c819060809" text="Comparer les sorties" /><string id="forge_9a50b0844ced" text="Effacer la sortie de référence" /><string id="forge_39f1002c9985" text="Sortie de référence" /><string id="forge_08c59e23faa9" text="Sortie actuelle" /><string id="forge_1113401f812c" text="Sortie de référence épinglée." /><string id="forge_3