ec871e37a" text="Znajdź obiekt według typu i identyfikatora. Przypnij punkt odniesienia przed porównaniem." /><string id="forge_ac76aefb08e7" text="Uruchom jeden identyfikator testu lub serię rozdzieloną przecinkami. Serie zatrzymują się przy pierwszym błędzie." /><string id="forge_80ca8e50e6e5" text="Sprawdź zainstalowane moduły bez zmieniania plików ani ustawień programu uruchamiającego." /><string id="forge_6d16fc3e9c38" text="Browse a live session or the current report. Export preserves the current report." /><string id="forge_442f6ea6fab1" text="Enable Live session to use game actions." /><string id="forge_81cfeb2db510" text="No records captured." /><string id="forge_371fa51b2bd8" text="Scan modules, open a report, or connect to Bannerlord to begin." /><string id="forge_16f776fa58d2" text="New report" /><string id="forge_967e1dd0e2fa" text="Captured live session" /><string id="forge_73d3559aa7c7" text="Usunięto migawkę" /><string id="forge_953f1b7e1234" text="Nie znaleziono migawki" /><string id="forge_0d7aa5e3fc18" text="Nieprawidłowy kontekst rozszerzenia" /><string id="forge_840f8e0862a9" text="Wybierz od 1 do 50 testów" /><string id="forge_dd9e54c609cb" text="Wersja Native" /><string id="forge_85a39ab345d6" text="Tak" /><string id="forge_1ea442a134b2" text="Nie" /><string id="forge_2b505597daa7" text="Dowolny" /><string id="forge_268286d2ef75" text="Kampania" /><string id="forge_e6b85bfbf550" text="Misja" /><string id="forge_143b270a3260" text="Kompletne" /><string id="forge_6be090825c99" text="Kolejność" /><string id="forge_18f2a0947f9d" text="Zablokowane" /><string id="forge_54a0e8c17ebb" text="Błąd" /><string id="forge_1993f23b0726" text="Brak wpisów dziennika pasujących do tego wyszukiwania." /><string id="forge_331e3ea43567" text="Wyczyść pole Wyszukiwanie / argument i naciśnij Ctrl+Enter, aby wyświetlić wszystkie dostępne wpisy." /><string id="forge_05d3ec58206c" text="Fokus klawiatury" /><string id="forge_9bae918add9a" text="Sekcje" /><string id="forge_a4e733eebdd3" text="Workbench" /><string id="forge_fc8a8bfccc30" text="Current source" /><string id="forge_6b1f854a4eaa" text="Session and files" /><string id="forge_5cde40fd111d" text="Section tools" /><string id="forge_219c4a6c86a7" text="Results" /><string id="forge_a4fe65264ef7" text="Language" /><string id="forge_d68761cc1eb2" text="Text size" /><string id="forge_6bef4668924c" text="Warsztat dewelopera" /><string id="forge_1c361d598197" text="Workbench sections" /><string id="forge_1ce46e1c33ba" text="Search or exact object/test ID" /><string id="forge_42bd9cd4555e" text="Test seed" /><string id="forge_e48fedcd517c" text="Operation in progress" /><string id="forge_06aa59d1fc7a" text="Report details" /><string id="forge_92c1cdfdf4cb" text="Włączone" /><string id="forge_75081b593d15" text="Wyłączone" /><string id="forge_ced6bf7b296b" text="Wybierz narzędzie" /><string id="forge_a1c0492f16ec" text="Moduły: sprawdź zależności.&#10;Inspektor: przechwyć stan obiektu.&#10;Testy: zweryfikuj rozszerzenie." /><string id="forge_0d8a6dd37429" text="Przeglądaj bezpiecznie. Testy zmieniające stan wymagają trybu testowego; testy kampanii wymagają też kopii roboczej." /><string id="forge_b82e7a80f6b4" text="Twoja sesja programistyczna w skrócie." /><string id="forge_f167862fa57f" text="Przeszukaj wpisy zarejestrowane w tej sesji. Pozostaw puste pole wyszukiwania, aby wyświetlić wszystkie." /><string id="forge_baf267e557d8" text="Pomiary obejmują operacje instrumentowane, a nie całą grę." /><string id="forge_ce02285cc14e" text="Work order" /><string id="forge_db798be1cd6f" text="Stan raportu" /><string id="forge_6a7a26775330" text="Zachowane dowody" /><string id="forge_c2eb8cd9d956" text="Attention" /><string id="forge_794131b64bc2" text="Laboratorium odtwarzania" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="Wprowadź zachowaną sekwencję zdarzenia, a następnie uruchom chronione odtworzenie." /><string id="forge_c8dae6371b33" text="Odtwórz" /><string id="forge_2d1e82553a41" text="Źródło odtworzenia" /><string id="forge_6b7609616c31" text="Wynik odtworzenia" /><string id="forge_ae02ff4ee2da" text="Tryb odtwarzania" /><string id="forge_274844a2a9d7" text="Odtworzenie odrzucone" /><string id="forge_ab9b00d2d398" text="Odtworzenie ukończone" /><string id="forge_19bc07d10e98" text="Wybierz zachowaną sekwencję zdarzenia." /><string id="forge_63bfa59d261f" text="Brak zachowanych zdarzeń." /><string id="forge_c490ac762d13" text="Odtwarzanie na żywo wykorzystuje istniejące zabezpieczenia trybu testowego i kopii kampanii." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="Skanuje tylko wskazany zestaw i rejestruje obsługiwane kontrakty SDK." /><string id="forge_ec2d15a6c2b8" text="Deklaruje samodzielny prefab Gauntlet, który Forge może otworzyć jako warstwę." /><string id="forge_4891dad02563" text="Deklaruje bezparametrowe polecenie Gauntlet i wymagany kontekst." /><string id="forge_0f22b4474d14" text="Prosi host Forge o otwarcie zarejestrowanej strony rozszerzenia." /><string id="forge_a105da0e865c" text="Odczytuje ograniczone metadane PE/.NET w tle bez ładowania ani uruchamiania DLL. Zmiana wersji wymaga podglądu i tworzy sprawdzoną kopię z kopią źródłową i skrótami." /><string id="forge_ed668f618580" text="Atrybuty sprawdzają metadane, ale nie izolują kodu innych twórców. Polecenia pozostają kodem autora i muszą przestrzegać zasad głównego wątku Bannerlorda." /><string id="forge_7398a2596036" text="Ścieżka zestawu lub indeks" /><string id="forge_dd167905de0d" text="Wersja" /><string id="forge_2ba785b2d3a4" text="Wyświetl zainstalowane biblioteki DLL" /><string id="forge_7d09a0fdc74d" text="Wybierz wiersz DLL" /><string id="forge_26c48e56ad62" text="Sprawdź metadane" /><string id="forge_ef91046c4294" text="Podgląd wersji" /><string id="forge_dbd8f023eda9" text="Zastosuj do kopii" /><string id="forge_0eac5d3fd9da" text="Warsztat zestawów" /><string id="forge_395b1be558b8" text="Otwórz stronę rozszerzenia" /><string id="forge_a1155cbb1daf" text="Pomoc kontekstowa" /><string id="forge_789588bda2aa" text="Strony rozszerzeń Gauntlet" /><string id="forge_b672f9bf0dab" text="Wpisz identyfikator strony w polu argumentu i wybierz Otwórz stronę rozszerzenia." /><string id="forge_32eaf5cf96d5" text="Użyj pomocy kontekstowej, aby uzyskać wskazówki SDK offline i otworzyć warsztat zestawów." /><string id="forge_346f06362ca2" text="Wskazówki warsztatu zestawów" /><string id="forge_0a10143c886e" text="Wyświetl zainstalowane DLL, wpisz numer wiersza i wybierz go. Inspekcja odczytuje tylko metadane PE; nie ładuje ani nie uruchamia pliku." /><string id="forge_c0287b2759d7" text="Aby zmienić wersję, wpisz cztery składniki, najpierw wyświetl podgląd, a następnie zastosuj, by utworzyć kopię w LocalAppData/CalradiaForge/AssemblyWorkbench." /><string id="forge_a75050e56e7d" text="Zestawy strong-name i mieszane są odrzucane. Oryginał pozostaje nienaruszony; zapisywana jest kopia źródłowa i suma SHA-256." /><string id="forge_a2256b564db1" text="Pomoc SDK w grze" /><string id="forge_b5911a953b0d" text="Nie znaleziono pasujących wierszy." /><string id="forge_dd3b39dacbf7" text="ZAAWANSOWANE SDK" /><string id="forge_f3bccf3efbfe" text="Audyt manifestu audio został zakończony." /><string id="forge_ee88528b0625" text="Test audio został wykonany." /><string id="forge_153f0a2d00cb" text="Przeglądaj ponad 110 zaawansowanych narzędzi SDK" /><string id="forge_04fb89acf8ae" text="HISTORIA POLECEŃ" /><string id="forge_1671fd14dfa5" text="Ocena casus belli została zakończona." /><string id="forge_9768be40e931" text="Wyczyść historię" /><string id="forge_4e6e062d6524" text="Czyści całą zapisaną historię poleceń." /><string id="forge_729f0343c990" text="Zamyka katalog SDK." /><string id="forge_af09632242f3" text="Skopiowano do schowka." /><string id="forge_1a5b5a6ad016" text="Symulacja przestępczości i półświatka została zakończona." /><string id="forge_75a51e1c4583" text="Ctrl+F: pole wejściowe · Ctrl+Enter: odśwież wynik" /><string id="forge_4e62272d6dc1" text="Ctrl+K: pomoc · Ctrl+W: monitoring · Tab: fokus" /><string id="forge_1b497f9d7f85" text="Ocena dynastii i sukcesji została zakończona." /><string id="forge_b13945c508a8" text="Filtr usunięty. Wyświetlane są wszystkie wiersze." /><string id="forge_055819ab7f57" text="Odfiltrowano do {0} pasujących wierszy." /><string id="forge_50ce67c7fc43" text="Pamięć sterty oczyszczona: odzyskano {0:F1} MB" /><string id="forge_6583c717f13e" text="Historia ▾" /><string id="forge_582f2cd9b20f" text="Monitoring na żywo włączony (interwał 1 s)" /><string id="forge_2d559fafb5c2" text="Monitoring na żywo wyłączony" /><string id="forge_2780abe560d2" text="Wczytuje następne polecenie z historii (strzałka w dół)." /><string id="forge_ed8b52d5e5c7" text="Wczytuje poprzednie polecenie z historii (strzałka w górę)." /><string id="forge_1c4c3d2a6aab" text="Audyt lokalizacji został zakończony." /><string id="forge_f5b3e708c545" text="Otwiera przeszukiwalny katalog zaawansowanych narzędzi SDK." /><string id="forge_0acff9a2de67" text="Wyczyszczono wyświetlane dane wyjściowe." /><string id="forge_298d79d4c832" text="Symulacja oddziału została zakończona." /><string id="forge_66a024aea84a" text="Katalog SDK" /><string id="for