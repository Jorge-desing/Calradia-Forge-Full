ge_c699aa00b26d" text="Sin cambios" /><string id="forge_7f136dc90ee4" text="El objeto ya no está disponible" /><string id="forge_ea7e47778b32" text="Abrir informe" /><string id="forge_442aded87a55" text="Rendimiento" /><string id="forge_ff1cee744146" text="Fijar" /><string id="forge_d5331b92de88" text="Fija primero este objeto" /><string id="forge_a57b08a480b8" text="Anterior" /><string id="forge_84428a7a8577" text="Datos originales" /><string id="forge_5fa7aac5375c" text="Listo" /><string id="forge_0e9161011702" text="Actualizar" /><string id="forge_486799b4dc10" text="Eliminar la dependencia circular" /><string id="forge_87e30f34875f" text="Ejecutar comando" /><string id="forge_e031e0df30c9" text="Ejecutar prueba" /><string id="forge_b2a3874a34ad" text="Revisar módulos" /><string id="forge_38d96da6e8b2" text="Revisando…" /><string id="forge_fbedbc133335" text="Buscar / argumento" /><string id="forge_367ef06b8fbf" text="Semilla" /><string id="forge_6959b4159575" text="Sesión" /><string id="forge_65e87299d316" text="ID del proceso de sesión" /><string id="forge_9adde7f0e05e" text="Solo un jugador" /><string id="forge_fcc153f25e94" text="Inicia Bannerlord con Calradia Forge activado y conecta. Puedes revisar módulos sin abrir el juego." /><string id="forge_8e76a94ac832" text="Resumen" /><string id="forge_16d1c9050a0b" text="Tabla" /><string id="forge_e806a291cfc3" text="Pruebas activadas" /><string id="forge_e5c9d7030bad" text="Pruebas" /><string id="forge_5d47e163e970" text="Tropas" /><string id="forge_1b9cdfe8dad9" text="Prueba desconocida" /><string id="forge_ceb4029165da" text="Usa una copia de la campaña. Esto habilita pruebas que modifican esta sesión." /><string id="forge_e4f882f185e7" text="Usar solo el nombre del archivo" /><string id="forge_b07f004258d7" text="Contexto incorrecto" /><string id="forge_f63010b0e68b" text="Capturar informe" /><string id="forge_94f506b7d34d" text="Sesión en vivo" /><string id="forge_f187f78e07ef" text="Instantáneas" /><string id="forge_2e41b118eb20" text="Dependencias" /><string id="forge_19fac1fc1f7b" text="Quitar instantánea" /><string id="forge_4fd763173e46" text="Ejecutar lote" /><string id="forge_04aec871e37a" text="Busca un objeto por tipo e ID. Fija una referencia antes de comparar." /><string id="forge_ac76aefb08e7" text="Ejecuta un ID de prueba o un lote separado por comas. El lote se detiene al primer fallo." /><string id="forge_80ca8e50e6e5" text="Revisa los módulos instalados sin cambiar archivos ni la configuración del lanzador." /><string id="forge_6d16fc3e9c38" text="Consulta una sesión en vivo o el informe actual. Exportar conserva el informe actual." /><string id="forge_442f6ea6fab1" text="Activa Sesión en vivo para usar las acciones del juego." /><string id="forge_81cfeb2db510" text="No se han capturado registros." /><string id="forge_371fa51b2bd8" text="Revisa los módulos, abre un informe o conéctate a Bannerlord para comenzar." /><string id="forge_16f776fa58d2" text="Informe nuevo" /><string id="forge_967e1dd0e2fa" text="Sesión en vivo capturada" /><string id="forge_73d3559aa7c7" text="Instantánea eliminada" /><string id="forge_953f1b7e1234" text="No se encontró la instantánea" /><string id="forge_0d7aa5e3fc18" text="Contexto de extensión inválido" /><string id="forge_840f8e0862a9" text="Selecciona entre 1 y 50 pruebas" /><string id="forge_dd9e54c609cb" text="Versión de Native" /><string id="forge_85a39ab345d6" text="Sí" /><string id="forge_1ea442a134b2" text="No" /><string id="forge_2b505597daa7" text="Cualquiera" /><string id="forge_268286d2ef75" text="Campaña" /><string id="forge_e6b85bfbf550" text="Misión" /><string id="forge_143b270a3260" text="Completo" /><string id="forge_6be090825c99" text="Orden" /><string id="forge_18f2a0947f9d" text="Bloqueados" /><string id="forge_54a0e8c17ebb" text="Error" /><string id="forge_1993f23b0726" text="No hay registros que coincidan con esta búsqueda." /><string id="forge_331e3ea43567" text="Borra Buscar / argumento y pulsa Ctrl+Enter para ver todos los registros disponibles." /><string id="forge_05d3ec58206c" text="Control seleccionado" /><string id="forge_9bae918add9a" text="Secciones" /><string id="forge_a4e733eebdd3" text="Mesa de trabajo" /><string id="forge_fc8a8bfccc30" text="Fuente actual" /><string id="forge_6b1f854a4eaa" text="Sesión y archivos" /><string id="forge_5cde40fd111d" text="Herramientas de la sección" /><string id="forge_219c4a6c86a7" text="Resultados" /><string id="forge_a4fe65264ef7" text="Idioma" /><string id="forge_d68761cc1eb2" text="Tamaño del texto" /><string id="forge_6bef4668924c" text="La forja del desarrollador" /><string id="forge_1c361d598197" text="Secciones de la mesa de trabajo" /><string id="forge_1ce46e1c33ba" text="Búsqueda o ID exacto de objeto o prueba" /><string id="forge_42bd9cd4555e" text="Semilla de prueba" /><string id="forge_e48fedcd517c" text="Operación en curso" /><string id="forge_06aa59d1fc7a" text="Detalles del informe" /><string id="forge_92c1cdfdf4cb" text="Activado" /><string id="forge_75081b593d15" text="Desactivado" /><string id="forge_ced6bf7b296b" text="Elige una herramienta" /><string id="forge_a1c0492f16ec" text="Módulos: revisa dependencias.&#10;Inspector: captura objetos.&#10;Pruebas: verifica tu extensión." /><string id="forge_0d8a6dd37429" text="Explora con seguridad. Las pruebas que cambian el estado requieren modo de pruebas; en campaña, también una copia de trabajo." /><string id="forge_b82e7a80f6b4" text="Tu sesión de desarrollo de un vistazo." /><string id="forge_f167862fa57f" text="Busca los registros de esta sesión. Deja la búsqueda vacía para mostrarlos todos." /><string id="forge_baf267e557d8" text="Las mediciones cubren operaciones instrumentadas, no todo el juego." /><string id="forge_ce02285cc14e" text="Orden de trabajo" /><string id="forge_db798be1cd6f" text="Estado del informe" /><string id="forge_6a7a26775330" text="Evidencia conservada" /><string id="forge_c2eb8cd9d956" text="Atención" /><string id="forge_794131b64bc2" text="Laboratorio de replay" /><string id="forge_662ba0a4a9c7" text="Repetir evento seleccionado" /><string id="forge_2d7b86e71bba" text="Escribe una secuencia de evento conservada y ejecuta un replay protegido." /><string id="forge_c8dae6371b33" text="Replay" /><string id="forge_2d1e82553a41" text="Origen del replay" /><string id="forge_6b7609616c31" text="Resultado del replay" /><string id="forge_ae02ff4ee2da" text="Modo de replay" /><string id="forge_274844a2a9d7" text="Replay rechazado" /><string id="forge_ab9b00d2d398" text="Replay completado" /><string id="forge_19bc07d10e98" text="Selecciona una secuencia de evento conservada." /><string id="forge_63bfa59d261f" text="No hay eventos conservados disponibles." /><string id="forge_c490ac762d13" text="El replay en vivo reutiliza las protecciones de modo de pruebas y copia de campaña." /><string id="forge_c224d4b803ff" text="Permiso de pruebas" /><string id="forge_ac2a84de8323" text="Evidencia seleccionada" /><string id="forge_973a01c05845" text="No hay evidencia seleccionada" /><string id="forge_30d5679ba22a" text="Secuencia de evento conservada" /><string id="forge_2cd6bc90d003" text="Informe sin conexión" /><string id="forge_40fa9ec67900" text="{0} seleccionada · {1} conservada" /><string id="forge_3ea66d904744" text="Conéctate a una sesión en vivo para repetir eventos conservados." /><string id="forge_5c8af69484dd" text="El juego conectado no expone el Laboratorio de replay." /><string id="forge_a93d7ced1fd1" text="El Laboratorio de replay de ForgeWeave reutiliza eventos conservados del host para verificación controlada. No intercepta métodos ni inyecta datos de eventos." /><string id="forge_f732d46f083f" text="Examina solo el ensamblado indicado y registra los contratos SDK compatibles." /><string id="forge_ec2d15a6c2b8" text="Declara un prefab Gauntlet independiente que Forge puede abrir como capa." /><string id="forge_4891dad02563" text="Declara un método de comando Gauntlet sin parámetros y su contexto requerido." /><string id="forge_0f22b4474d14" text="Solicita al host de Forge que abra una página de extensión registrada." /><string id="forge_a105da0e865c" text="Lee metadatos PE/.NET acotados en segundo plano sin cargar ni ejecutar la DLL. Los cambios de versión requieren una vista previa y crean una copia validada con respaldo y hashes." /><string id="forge_ed668f618580" text="Los atributos validan metadatos, no aíslan código de terceros. Los comandos siguen siendo código del autor y deben respetar las reglas de hilo principal de Bannerlord." /><string id="forge_7398a2596036" text="Ruta del ensamblado o índice" /><string id="forge_dd167905de0d" text="Versión" /><string id="forge_2ba785b2d3a4" text="Listar DLL instaladas" /><string id="forge_7d09a0fdc74d" text="Seleccionar fila DLL" /><string id="forge_26c48e56ad62" text="Inspeccionar metadatos" /><string id="forge_ef91046c4294" text="Vista previa de versión" /><string id="forge_dbd8f023eda9" text="Aplicar a una copia" /><string id="forge_0eac5d3fd9da" text="Banco de ensamblados" /><string id="forge_395b1be558b8" text="Abrir página de extensión" /><string id="forge_a1155cbb1daf" text="Ayuda contextual" /><string id="forge_789588bda2aa" text="Páginas de extensión Gauntlet" /><string id="forge_b672f9bf0dab" text="Escribe el ID de una página en el campo de argumento y pulsa Abrir página de extensión." /><string id="forge_32eaf5cf96d5" text="Usa Ayuda contextual para consultar la guía SDK sin conexión y el banco de ensamblados." /><string id="forge_346f06362ca2" text="Guía del banco de ensamblados" /><string id="forge_0a10143c886e" text="Lista las DLL instaladas, escribe el número de una fila y selecciónala. La inspección solo lee metadatos PE; nunca carga ni ejecuta el archivo." /><string id="forge_c0287b2759d7" text="Para cambiar la versión, escribe cuatro componentes, revisa la vista previa y aplica solo para crear una copia en LocalAppData/CalradiaForge/AssemblyWorkbench." /><string id="forge_a75050e56e7d" text="Se rechazan ensamblados firmados con strong name y de modo mixto. El original se conserva; se guarda una copia fuente y evidencia SHA-256." /><string id="forge_a2256b564db1" text="Ayuda del SDK en el juego" /><string id="forge_b5911a953b0d" text="No se encontraron líneas coincidentes." /><string id="forge_dd3b39dacbf7" text="SDK AVANZADO" /><string id="forge_f3bccf3efbfe" text="La auditoría del manifiesto de audio se completó." /><string id="forge_ee88528b0625" text="La prueba de audio se ejecutó." /><string id="forge_153f0a2d00cb" text="Explora las más de 110 herramientas avanzadas del SDK" /><string id="forge_04fb89acf8ae" text="HISTORIAL DE COMANDOS" /><string id="forge_1671fd14dfa5" text="La evaluación de Casus Belli se completó." /><string id="forge_9768be40e931" text="Borrar historial" /><string id="forge_4e6e062d6524" text="Borra todo el historial de comandos guardado." /><string id="forge_729f0343c990" text="Cierra el catálogo del SDK." /><string id="forge_af09632242f3" text="Se copió al portapapeles." /><string id="forge_1a5b5a6ad016" text="La simulación de crimen y bajos fondos se completó." /><string id="forge_75a51e1c4583" text="Ctrl+F: entrada · Ctrl+Enter: actualizar la salida" /><string id="forge_4e62272d6dc1" text="Ctrl+K: ayuda · Ctrl+W: supervisión · Tab: foco" /><string id="forge_1b497f9d7f85" text="La evaluación de dinastía y sucesión se completó." /><string id="forge_b13945c508a8" text="Se quitó el filtro. Se muestran todas las líneas." /><string id="forge_055819ab7f57" text="Se filtraron {0} líneas coincidentes." /><string id="forge_50ce67c7fc43" text="Heap depurado: se recuperaron {0:F1} MB" /><string id="forge_6583c717f13e" text="Historial ▾" /><string id="forge_582f2cd9b20f" text="Supervisión en vivo activada (intervalo de 1 s)" /><string id="forge_2d559fafb5c2" text="Supervisión en vivo desactivada" /><string id="forge_2780abe560d2" text="Carga el siguiente comando del historial (flecha abajo)." /><string id="forge_ed8b52d5e5c7" text=