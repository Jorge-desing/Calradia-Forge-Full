string id="forge_2d7b86e71bba" text="Korunan bir olay dizisi girin, ardından korumalı yeniden oynatmayı çalıştırın." /><string id="forge_c8dae6371b33" text="Yeniden oynat" /><string id="forge_2d1e82553a41" text="Yeniden oynatma kaynağı" /><string id="forge_6b7609616c31" text="Yeniden oynatma sonucu" /><string id="forge_ae02ff4ee2da" text="Yeniden oynatma modu" /><string id="forge_274844a2a9d7" text="Yeniden oynatma reddedildi" /><string id="forge_ab9b00d2d398" text="Yeniden oynatma tamamlandı" /><string id="forge_19bc07d10e98" text="Korunan bir olay dizisi seçin." /><string id="forge_63bfa59d261f" text="Korunan olay yok." /><string id="forge_c490ac762d13" text="Canlı yeniden oynatma, mevcut test modu ve kampanya kopyası korumalarını yeniden kullanır." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="Yalnızca belirtilen derlemeyi tarar ve desteklenen SDK sözleşmelerini kaydeder." /><string id="forge_ec2d15a6c2b8" text="Forge'un katman olarak açabileceği bağımsız bir Gauntlet prefab'ı bildirir." /><string id="forge_4891dad02563" text="Parametresiz bir Gauntlet komut yöntemini ve gereken bağlamı bildirir." /><string id="forge_0f22b4474d14" text="Forge ana bilgisayarından kayıtlı uzantı sayfasını açmasını ister." /><string id="forge_a105da0e865c" text="Seçilen DLL'yi yüklemeden veya çalıştırmadan PE/.NET meta verilerini arka planda sınırlandırılmış olarak okur. Sürüm değişikliği önizleme gerektirir ve yedek ile karma değerleri içeren doğrulanmış bir kopya oluşturur." /><string id="forge_ed668f618580" text="Öznitelikler meta verileri doğrular; üçüncü taraf kodunu yalıtmaz. Sayfa komutları mod yazarının kodudur ve Bannerlord ana iş parçacığı kurallarına uymalıdır." /><string id="forge_7398a2596036" text="Derleme yolu veya sıra" /><string id="forge_dd167905de0d" text="Sürüm" /><string id="forge_2ba785b2d3a4" text="Yüklü DLL'leri listele" /><string id="forge_7d09a0fdc74d" text="DLL satırını seç" /><string id="forge_26c48e56ad62" text="Meta verileri incele" /><string id="forge_ef91046c4294" text="Sürüm önizlemesi" /><string id="forge_dbd8f023eda9" text="Kopyaya uygula" /><string id="forge_0eac5d3fd9da" text="Derleme çalışma alanı" /><string id="forge_395b1be558b8" text="Uzantı sayfasını aç" /><string id="forge_a1155cbb1daf" text="Bağlamsal yardım" /><string id="forge_789588bda2aa" text="Gauntlet uzantı sayfaları" /><string id="forge_b672f9bf0dab" text="Argüman alanına bir sayfa kimliği yazıp Uzantı sayfasını aç'ı seçin." /><string id="forge_32eaf5cf96d5" text="Çevrimdışı SDK rehberi ve Derleme çalışma alanı için Bağlamsal yardımı kullanın." /><string id="forge_346f06362ca2" text="Derleme çalışma alanı yönergeleri" /><string id="forge_0a10143c886e" text="Yüklü DLL'leri listeleyin, satır numarasını girip seçin. İnceleme yalnızca PE meta verilerini okur; dosyayı yüklemez veya çalıştırmaz." /><string id="forge_c0287b2759d7" text="Sürümü değiştirmek için dört bileşenli sürüm girin, önce önizleyin ve yalnızca LocalAppData/CalradiaForge/AssemblyWorkbench altında kopya oluşturmak için uygulayın." /><string id="forge_a75050e56e7d" text="Strong-name imzalı ve karma modlu derlemeler reddedilir. Özgün dosya korunur; kaynak yedeği ve SHA-256 kanıtı kaydedilir." /><string id="forge_a2256b564db1" text="Oyun içi SDK yardımı" /><string id="forge_b5911a9