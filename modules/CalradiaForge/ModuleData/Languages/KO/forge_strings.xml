string id="forge_5fa7aac5375c" text="준비됨" /><string id="forge_0e9161011702" text="새로 고침" /><string id="forge_486799b4dc10" text="Remove circular dependency" /><string id="forge_87e30f34875f" text="Run command" /><string id="forge_e031e0df30c9" text="테스트 실행" /><string id="forge_b2a3874a34ad" text="모듈 검사" /><string id="forge_38d96da6e8b2" text="Scanning…" /><string id="forge_fbedbc133335" text="검색 / 인수" /><string id="forge_367ef06b8fbf" text="시드" /><string id="forge_6959b4159575" text="세션" /><string id="forge_65e87299d316" text="Session process ID" /><string id="forge_9adde7f0e05e" text="싱글플레이어 전용" /><string id="forge_fcc153f25e94" text="Start Bannerlord with Calradia Forge enabled, then connect. Offline module scanning is available without the game." /><string id="forge_8e76a94ac832" text="개요" /><string id="forge_16d1c9050a0b" text="Table" /><string id="forge_e806a291cfc3" text="테스트 모드" /><string id="forge_e5c9d7030bad" text="테스트" /><string id="forge_5d47e163e970" text="Troops" /><string id="forge_1b9cdfe8dad9" text="알 수 없는 테스트" /><string id="forge_ceb4029165da" text="Use a copied campaign. This enables state-changing tests for this session." /><string id="forge_e4f882f185e7" text="Use filename only" /><string id="forge_b07f004258d7" text="잘못된 컨텍스트" /><string id="forge_f63010b0e68b" text="Capture report" /><string id="forge_94f506b7d34d" text="실시간 세션" /><string id="forge_f187f78e07ef" text="스냅샷" /><string id="forge_2e41b118eb20" text="의존성" /><string id="forge_19fac1fc1f7b" text="스냅샷 삭제" /><string id="forge_4fd763173e46" text="일괄 실행" /><string id="forge_04aec871e37a" text="유형과 ID로 객체를 찾으세요. 비교하기 전에 기준선을 고정하세요." /><string id="forge_ac76aefb08e7" text="테스트 ID 하나 또는 쉼표로 구분한 일괄 작업을 실행하세요. 일괄 작업은 첫 실패에서 중지됩니다." /><string id="forge_80ca8e50e6e5" text="파일이나 실행기 설정을 바꾸지 않고 설치된 모듈을 검사합니다." /><string id="forge_6d16fc3e9c38" text="Browse a live session or the current report. Export preserves the current report." /><string id="forge_442f6ea6fab1" text="Enable Live session to use game actions." /><string id="forge_81cfeb2db510" text="No records captured." /><string id="forge_371fa51b2bd8" text="Scan modules, open a report, or connect to Bannerlord to begin." /><string id="forge_16f776fa58d2" text="New report" /><string id="forge_967e1dd0e2fa" text="Captured live session" /><string id="forge_73d3559aa7c7" text="스냅샷을 제거했습니다" /><string id="forge_953f1b7e1234" text="스냅샷을 찾을 수 없습니다" /><string id="forge_0d7aa5e3fc18" text="잘못된 확장 컨텍스트" /><string id="forge_840f8e0862a9" text="1~50개의 테스트를 선택하세요" /><string id="forge_dd9e54c609cb" text="Native 버전" /><string id="forge_85a39ab345d6" text="예" /><string id="forge_1ea442a134b2" text="아니요" /><string id="forge_2b505597daa7" text="모든 컨텍스트" /><string id="forge_268286d2ef75" text="캠페인" /><string id="forge_e6b85bfbf550" text="미션" /><string id="forge_143b270a3260" text="완료" /><string id="forge_6be090825c99" text="순서" /><string id="forge_18f2a0947f9d" text="차단됨" /><string id="forge_54a0e8c17ebb" text="오류" /><string id="forge_1993f23b0726" text="이 검색과 일치하는 로그 항목이 없습니다." /><string id="forge_331e3ea43567" text="모든 로그를 표시하려면 검색 / 인수를 지우고 Ctrl+Enter를 누르세요." /><string id="forge_05d3ec58206c" text="키보드 포커스" /><string id="forge_9bae918add9a" text="섹션" /><string id="forge_a4e733eebdd3" text="Workbench" /><string id="forge_fc8a8bfccc30" text="Current source" /><string id="forge_6b1f854a4eaa" text="Session and files" /><string id="forge_5cde40fd111d" text="Section tools" /><string id="forge_219c4a6c86a7" text="Results" /><string id="forge_a4fe65264ef7" text="Language" /><string id="forge_d68761cc1eb2" text="Text size" /><string id="forge_6bef4668924c" text="개발자 작업대" /><string id="forge_1c361d598197" text="Workbench sections" /><string id="forge_1ce46e1c33ba" text="Search or exact object/test ID" /><string id="forge_42bd9cd4555e" text="Test seed" /><string id="forge_e48fedcd517c" text="Operation in progress" /><string id="forge_06aa59d1fc7a" text="Report details" /><string id="forge_92c1cdfdf4cb" text="활성화됨" /><string id="forge_75081b593d15" text="비활성화됨" /><string id="forge_ced6bf7b296b" text="도구 선택" /><string id="forge_a1c0492f16ec" text="모듈: 종속성을 확인하세요.&#10;검사기: 객체 상태를 캡처하세요.&#10;테스트: 확장을 확인하세요." /><string id="forge_0d8a6dd37429" text="안전하게 살펴보세요. 상태를 바꾸는 테스트에는 테스트 모드가 필요하며, 캠페인 테스트에는 작업 사본도 필요합니다." /><string id="forge_b82e7a80f6b4" text="개발 세션을 한눈에 확인하세요." /><string id="forge_f167862fa57f" text="이 세션에서 캡처한 기록을 검색하세요. 모두 표시하려면 검색을 비워 두세요." /><string id="forge_baf267e557d8" text="측정값은 계측된 작업만 다루며 게임 전체를 다루지 않습니다." /><string id="forge_ce02285cc14e" text="Work order" /><string id="forge_db798be1cd6f" text="보고서 상태" /><string id="forge_6a7a26775330" text="보존된 증거" /><string id="forge_c2eb8cd9d956" text="Attention" /><string id="forge_794131b64bc2" text="재생 실험실" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="보존된 이벤트 시퀀스를 입력한 뒤 보호된 재생을 실행하세요." /><string id="forge_c8dae6371b33" text="재생" /><string id="forge_2d1e82553a41" text="재생 원본" /><string id="forge_6b7609616c31" text="재생 결과" /><string id="forge_ae02ff4ee2da" text="재생 모드" /><string id="forge_274844a2a9d7" text="재생 거부됨" /><string id="forge_ab9b00d2d398" text="재생 완료" /><string id="forge_19bc07d10e98" text="보존된 이벤트 시퀀스를 선택하세요." /><string id="forge_63bfa59d261f" text="보존된 이벤트가 없습니다." /><string id="forge_c490ac762d13" text="실시간 재생은 기존 테스트 모드와 캠페인 복사본 보호를 재사용합니다." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="지정한 어셈블리만 검사하고 지원되는 SDK 계약을 등록합니다." /><string id="forge_ec2d15a6c2b8" text="Forge가 별도 레이어로 열 수 있는 독립 Gauntlet 프리팹을 선언합니다." /><string id="forge_4891dad02563" text="매개변수가 없는 Gauntlet 명령 메서드와 필요한 컨텍스트를 선언합니다." /><string id="forge_0f22b4474d14" text="Forge 호스트에 등록된 확장 페이지를 열도록 요청합니다." /><string id="forge_a105da0e865c" text="선택한 DLL을 로드하거나 실행하지 않고 제한된 PE/.NET 메타데이터를 백그라운드에서 읽습니다. 버전 변경은 미리보기 후 백업과 해시가 포함된 검증된 복사본을 만듭니다." /><string id="forge_ed668f618580" text="특성은 메타데이터를 검증할 뿐 타사 코드를 격리하지 않습니다. 페이지 명령은 확장 작성자의 코드이며 Bannerlord 주 스레드 규칙을 따라야 합니다." /><string id="forge_7398a2596036" text="어셈블리 경로 또는 번호" /><string id="forge_dd167905de0d" text="버전" /><string id="forge_2ba785b2d3a4" text="설치된 DLL 목록" /><string id="forge_7d09a0fdc74d" text="DLL 행 선택" /><string id="forge_26c48e56ad62" text="메타데이터 검사" /><string id="forge_ef91046c4294" text="버전 미리보기" /><string id="forge_dbd8f023eda9" text="복사본에 적용" /><string id="forge_0eac5d3fd9da" text="어셈블리 작업대" /><string id="forge_395b1be558b8" text="확장 페이지 열기" /><string id="forge_a1155cbb1daf" text="상황별 도움말" /><string id="forge_789588bda2aa" text="Gauntlet 확장 페이지" /><string id="forge_b672f9bf0dab" text="인수 칸에 페이지 ID를 입력한 뒤 확장 페이지 열기를 선택하세요." /><string id="forge_32eaf5cf96d5" text="오프라인 SDK 안내와 어셈블리 작업대에는 상황별 도움말을 사용하세요." /><string id="forge_346f06362ca2" text="어셈블리 작업대 안내" /><string id="forge_0a10143c886e" text="설치된 DLL을 나열하고 행 번호를 입력해 선택하세요. 검사는 PE 메타데이터만 읽으며 파일을 로드하거나 실행하지 않습니다." /><string id="forge_c0287b2759d7" text="버전을 변경하려면 네 부분 버전을 입력하고 미리보기 후 적용하세요. LocalAppData/CalradiaForge/AssemblyWorkbench에 복사본을 만듭니다." /><string id="forge_a75050e56e7d" text="strong-name 서명 및 혼합 모드 어셈블리는 거부됩니다. 원본을 보존하고 소스 백업과 SHA-256 증거를 기록합니다." /><string id="forge_a2256b564db1" text="게임 내 SDK 도움말" /><string id="forge_b5911a953b0d" text="일치하는 줄을 찾지 못했습니다." /><string id="forge_dd3b39dacbf7" text="고급 SDK" /><string id="forge_f3bccf3efbfe" text="오디오 매니페스트 감사가 완료되었습니다." /><string id="forge_ee88528b0625" text="오디오 테스트를 실행했습니다." /><string id="forge_153f0a2d00cb" text="110개가 넘는 고급 SDK 도구를 모두 살펴보세요" /><string id="forge_04fb89acf8ae" text="명령 기록" /><string id="forge_1671fd14dfa5" text="전쟁 명분 평가가 완료되었습니다." /><string id="forge_9768be40e931" text="기록 지우기" /><string id="forge_4e6e062d6524" text="저장된 명령 기록을 모두 지웁니다." /><string id="forge_729f0343c990" text="SDK 카탈로그를 닫습니다." /><string id="forge_af09632242f3" text="클립보드에 복사했습니다." /><string id="forge_1a5b5a6ad016" text="범죄 및 지하 세계 시뮬레이션이 완료되었습니다." /><string id="forge_75a51e1c4583" text="Ctrl+F: 입력 · Ctrl+Enter: 출력 새로 고침" /><string id="forge_4e62272d6dc1" text="Ctrl+K: 도움말 · Ctrl+W: 모니터링 · Tab: 포커스" /><string id="forge_1b497f9d7f85" text="왕조 및 계승 평가가 완료되었습니다." /><string id="forge_b13945c508a8" text="필터를 지웠습니다. 모든 줄을 표시합니다." /><string id="forge_055819ab7f57" text="일치하는 줄 {0}개로 필터링했습니다." /><string id="forge_50ce67c7fc43" text="힙을 정리했습니다: {0:F1}MB 회수" /><string id="forge_6583c717f13e" text="기록 ▾" /><string id="forge_582f2cd9b20f" text="실시간 모니터링을 켰습니다(1초 간격)" /><string id="forge_2d559fafb5c2" text="실시간 모니터링을 껐습니다" /><string id="forge_2780abe560d2" text="기록에서 다음 명령을 불러옵니다(아래쪽 화살표)." /><string id="forge_ed8b52d5e5c7" text="기록에서 이전 명령을 불러옵니다(위쪽 화살표)." /><string id="forge_1c4c3d2a6aab" text="현지화 감사를 완료했습니다." /><string id="forge_f5b3e708c545" text="검색 가능한 고급 SDK 도구 카탈로그를 엽니다." /><string id="forge_0acff9a2de67" text="표시된 출력을 지웠습니다." /><string id="forge_298d79d4c832" text="부대 시뮬레이션이 완료되었습니다." /><string id="forge_66a024aea84a" text="SDK 카탈로그" /><string id="forge_50e8fa699d85" text="저장 시스템 상태 감사를 통과했습니다." /><string id="forge_f4b0f74fd12a" text="기본 틀을 생성했습니다. 클립보드에 복사하여 저장하세요." /><string id="forge_fb69d1d9a74d" text="공성 전술 분석이 완료되었습니다." /><string id="forge_78d49d020849" text="최근 명령 기록 드롭다운을 표시하거나 숨깁니다." /><string id="forge_a006eefe667b" text="전술 키보드 단축키 안내를 표시하거나 숨깁니다(Ctrl+K)." /><string id="forge_c5de2e25402f" text="무역 시뮬레이션이 완료되었습니다." /><string id="forge_05d04cc462be" text="[ ⌨ 키 ]" /><string id="forge_71886b7929d2" text="도구 인수를 변경하지 않고 현재 출력을 필터링합니다." /><string id="forge_f5b680c59d2d" text="출력 줄 필터링..." /><string id="forge_d03ed87a54bf" text="출력 필터 지우기." /><string id="forge_c6ece04535b2" text="이 필터와 일치하는 출력 줄이 없습니다." /><string id="forge_03867aea70ac" text="증거" /><string id="forge_78f6584233f0" text="출력 기준선 고정" /><string id="forge_11c819060809" text="출력 비교" /><string id="forge_9a50b0844ced" text="출력 기준선 지우기" /><string id="forge_39f1002c9985" text="기준 출력" /><string id="forge_08c59e23faa9" text="현재 출력" /><string id="forge_1113401f812c" text="출력 기준선을 고정했습니다." /><string id="forge_3fde84f2ab44" text="비교하기 전에 출력 기준선을 고정하세요." /><string id="forge_5d86a0faffd1" text="비교할 현재 출력이 없습니다." /><string id="forge_6c1ac74796b8" text="양쪽 모두 필터와 일치하는 출력이 없습니다." /><string id="forge_bd1df295578a" text="구성된 입력 또는 작업 한도에 도달하여 출력을 비교할 수 없습니다." /><string id="forge_ffd7d472607e" text="출력이 비교 한도를 초과했습니다. 기준선은 변경되지 않았습니다." /><string id="forge_88b85e285a97" text="현재 출력 표시" /><string id="forge_e502caae4ef2" text="현재 출력을 비교 기준선으로 고정합니다." /><string id="forge_f1bc98b71e17" text="기준 출력과 현재 출력을 나란히 표시합니다." /><string id="forge_fd24a42a4fba" text="기준선을 유지하고 현재 출력으로 돌아갑니다." /><string id="forge_20a3d4005399" text="고정된 출력 기준선을 지웁니다." /><string id="forge_13d0d65407e2" text="출력 기준선을 지웠습니다." /><string id="forge_3ea6008c2f7d" text="테스트 결과" /><string id="forge_c0220b5dd3c3" text="최근 테스트 결과" /><string id="forge_01258bd385ea" text="테스트 결과 열기" /><string id="forge_c0dc59381184" text="테스트 결과 닫기" /><string id="forge_66388b09af1b" text="아직 테스트 결과가 없습니다." /><string id="forge_5cd7bbf04dc0" text="테스트 결과 세부 정보" /><string id="forge_ecbc89cd37a0" text="시작 시간" /><string id="forge_1de3df70ddf4" text="단계" /><string id="forge_25f08afdd4ca" text="정리 오류" /><string id="forge_9ed6fabb9d04" text="최근 테스트 응답의 결과 {0}개를 표시합니다." /><string id="forge_43878b2de274" text="세부 정보를 보려면 결과를 선택하세요." /><string id="forge_4a5c744c9473" text="테스트 ID" /><string id="forge_920e413c7d41" text="상태" /><string id="forge_4fc52a3c4c55" text="기간" /><string id="forge_916497b4c2fd" text="증거 집중" /><string id="forge_9d67b6069665" text="도구 표시" /><string id="forge_3a738bcb53b2" text="빠른 탐색" /><string id="forge_241bd2cd0c42" text="활성 보기" /><string id="forge_9b0f9e9587d9" text="모든 경로와 SDK 도구를 검색하려면 입력하세요." /><string id="forge_2c326441d438" text="일치하는 경로가 없습니다." /><string id="forge_85ad813360db" text="보기 및 SDK 도구 검색" /><string id="forge_ec7f4320f39d" text="↑/↓ 이동 · Enter 열기 · Esc 닫기 · Ctrl+P 전환" /><string id="forge_1810407f5ab7" text="빠른 작업" /><string id="forge_512c84789fba" text="검색에 포커스" /><string id="forge_2d8cafe0d1f8" text="현재 섹션의 검색 또는 인수 필드에 포커스를 둡니다." /><string id="forge_7a1f2a83aca9" text="즐겨찾기" /><string id="forge_690dbe9dc099" text="최근 항목" /><string id="forge_a98de9121cb4" text="실시간 감시 전환" /><string id="forge_5bc0aa08d678" text="즐겨찾기에서 제거" /><string id="forge_65b52e8c6521" text="즐겨찾기에 추가" /><string id="forge_40f2c1871b3f" text="이 보기의 컨트롤을 사용해 작업을 실행하세요." /></strings></base>