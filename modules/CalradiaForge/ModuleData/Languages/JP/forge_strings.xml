d to begin." /><string id="forge_16f776fa58d2" text="New report" /><string id="forge_967e1dd0e2fa" text="Captured live session" /><string id="forge_73d3559aa7c7" text="スナップショットを削除しました" /><string id="forge_953f1b7e1234" text="スナップショットが見つかりません" /><string id="forge_0d7aa5e3fc18" text="無効な拡張コンテキスト" /><string id="forge_840f8e0862a9" text="1 ～ 50 件のテストを選択" /><string id="forge_dd9e54c609cb" text="Native バージョン" /><string id="forge_85a39ab345d6" text="はい" /><string id="forge_1ea442a134b2" text="いいえ" /><string id="forge_2b505597daa7" text="任意" /><string id="forge_268286d2ef75" text="キャンペーン" /><string id="forge_e6b85bfbf550" text="ミッション" /><string id="forge_143b270a3260" text="完了" /><string id="forge_6be090825c99" text="順序" /><string id="forge_18f2a0947f9d" text="ブロック済み" /><string id="forge_54a0e8c17ebb" text="エラー" /><string id="forge_1993f23b0726" text="この検索に一致するログ項目はありません。" /><string id="forge_331e3ea43567" text="「検索 / 引数」をクリアして Ctrl+Enter を押すと、すべてのログが表示されます。" /><string id="forge_05d3ec58206c" text="キーボードフォーカス" /><string id="forge_9bae918add9a" text="セクション" /><string id="forge_a4e733eebdd3" text="Workbench" /><string id="forge_fc8a8bfccc30" text="Current source" /><string id="forge_6b1f854a4eaa" text="Session and files" /><string id="forge_5cde40fd111d" text="Section tools" /><string id="forge_219c4a6c86a7" text="Results" /><string id="forge_a4fe65264ef7" text="Language" /><string id="forge_d68761cc1eb2" text="Text size" /><string id="forge_6bef4668924c" text="開発者ワークベンチ" /><string id="forge_1c361d598197" text="Workbench sections" /><string id="forge_1ce46e1c33ba" text="Search or exact object/test ID" /><string id="forge_42bd9cd4555e" text="Test seed" /><string id="forge_e48fedcd517c" text="Operation in progress" /><string id="forge_06aa59d1fc7a" text="Report details" /><string id="forge_92c1cdfdf4cb" text="有効" /><string id="forge_75081b593d15" text="無効" /><string id="forge_ced6bf7b296b" text="ツールを選択" /><string id="forge_a1c0492f16ec" text="モジュール: 依存関係を確認。&#10;インスペクター: オブジェクトの状態を取得。&#10;テスト: 拡張機能を確認。" /><string id="forge_0d8a6dd37429" text="安全に確認できます。状態を変更するテストにはテストモードが必要で、キャンペーンテストには作業用コピーも必要です。" /><string id="forge_b82e7a80f6b4" text="開発セッションの概要。" /><string id="forge_f167862fa57f" text="このセッションで取得した記録を検索します。すべて表示するには検索を空のままにします。" /><string id="forge_baf267e557d8" text="測定対象は計測済みの操作であり、ゲーム全体ではありません。" /><string id="forge_ce02285cc14e" text="Work order" /><string id="forge_db798be1cd6f" text="レポートの状態" /><string id="forge_6a7a26775330" text="保持された証拠" /><string id="forge_c2eb8cd9d956" text="Attention" /><string id="forge_794131b64bc2" text="再生ラボ" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="保持されたイベントシーケンスを入力して、保護された再生を実行します。" /><string id="forge_c8dae6371b33" text="再生" /><string id="forge_2d1e82553a41" text="再生元" /><string id="forge_6b7609616c31" text="再生結果" /><string id="forge_ae02ff4ee2da" text="再生モード" /><string id="forge_274844a2a9d7" text="再生は拒否されました" /><string id="forge_ab9b00d2d398" text="再生完了" /><string id="forge_19bc07d10e98" text="保持されたイベントシーケンスを選択してください。" /><string id="forge_63bfa59d261f" text="保持されたイベントはありません。" /><string id="forge_c490ac762d13" text="ライブ再生では、既存のテストモードとキャンペーンコピーの保護を再利用します。" /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="指定したアセンブリだけを検査し、対応する SDK 契約を登録します。" /><string id="forge_ec2d15a6c2b8" text="Forge が独立したレイヤーとして開ける Gauntlet prefab を宣言します。" /><string id="forge_4891dad02563" text="パラメーターなしの Gauntlet コマンドと必要なコンテキストを宣言します。" /><string id="forge_0f22b4474d14" text="Forge ホストに登録済みの拡張ページを開くよう要求します。" /><string id="forge_a105da0e865c" text="DLL を読み込み・実行せず、制限付き PE/.NET メタデータをバックグラウンドで読み取ります。バージョン変更はプレビュー後に、バックアップとハッシュ付きの検証済みコピーを作成します。" /><string id="forge_ed668f618580" text="属性はメタデータを検証しますが、第三者コードを隔離しません。ページコマンドは拡張作者のコードであり、Bannerlord のメインスレッド規則に従う必要があります。" /><string id="forge_7398a2596036" text="アセンブリのパスまたは番号" /><string id="forge_dd167905de0d" text="バージョン" /><string id="forge_2ba785b2d3a4" text="インストール済み DLL を一覧表示" /><string id="forge_7d09a0fdc74d" text="DLL の行を選択" /><string id="forge_26c48e56ad62" text="メタデータを検査" /><string id="forge_ef91046c4294" text="バージョンをプレビュー" /><string id="forge_dbd8f023eda9" text="コピーに適用" /><string id="forge_0eac5d3fd9da" text="アセンブリ作業台" /><string id="forge_395b1be558b8" text="拡張ページを開く" /><string id="forge_a1155cbb1daf" text="コンテキストヘルプ" /><string id="forge_789588bda2aa" text="Gauntlet 拡張ページ" /><string id="forge_b672f9bf0dab" text="引数欄にページ ID を入力し、拡張ページを開くを選択します。" /><string id="forge_32eaf5cf96d5" text="オフライン SDK ガイドとアセンブリ作業台にはコンテキストヘルプを使用します。" /><string id="forge_346f06362ca2" text="アセンブリ作業台のガイド" /><string id="forge_0a10143c886e" text="インストール済み DLL を一覧表示し、行番号を入力して選択します。検査は PE メタデータのみを読み、ファイルを読み込み・実行しません。" /><string id="forge_c0287b2759d7" text="バージョン変更では 4 つの数値を入力し、先にプレビューしてから適用すると LocalAppData/CalradiaForge/AssemblyWorkbench にコピーが作成されます。" /><string id="forge_a75050e56e7d" text="strong name 署名済みおよび混合モードのアセンブリは拒否されます。元ファイルを保持し、ソースのバックアップと SHA-256 証跡を保存します。" /><string id="forge_a2256b564db1" text="ゲーム内 SDK ヘルプ" /><string id="forge_b5911a953b0d" text="一致する行が見つかりません。" /><string id="forge_dd3b39dacbf7" text="高度な SDK" /><string id="forge_f3bccf3efbfe" text="オーディオマニフェストの監査が完了しました。" /><string id="forge_ee88528b0625" text="オーディオテストを実行しました。" /><string id="forge_153f0a2d00cb" text="110 件以上の高度な SDK ツールをすべて閲覧" />