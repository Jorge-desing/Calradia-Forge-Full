="forge_04aec871e37a" text="Найдите объект по типу и ID. Закрепите исходное состояние перед сравнением." /><string id="forge_ac76aefb08e7" text="Запустите один ID теста или пакет, разделённый запятыми. Пакеты останавливаются при первой ошибке." /><string id="forge_80ca8e50e6e5" text="Проверьте установленные модули без изменения файлов или настроек лаунчера." /><string id="forge_6d16fc3e9c38" text="Browse a live session or the current report. Export preserves the current report." /><string id="forge_442f6ea6fab1" text="Enable Live session to use game actions." /><string id="forge_81cfeb2db510" text="No records captured." /><string id="forge_371fa51b2bd8" text="Scan modules, open a report, or connect to Bannerlord to begin." /><string id="forge_16f776fa58d2" text="New report" /><string id="forge_967e1dd0e2fa" text="Captured live session" /><string id="forge_73d3559aa7c7" text="Снимок удалён" /><string id="forge_953f1b7e1234" text="Снимок не найден" /><string id="forge_0d7aa5e3fc18" text="Недопустимый контекст расширения" /><string id="forge_840f8e0862a9" text="Выберите от 1 до 50 тестов" /><string id="forge_dd9e54c609cb" text="Версия Native" /><string id="forge_85a39ab345d6" text="Да" /><string id="forge_1ea442a134b2" text="Нет" /><string id="forge_2b505597daa7" text="Любой" /><string id="forge_268286d2ef75" text="Кампания" /><string id="forge_e6b85bfbf550" text="Миссия" /><string id="forge_143b270a3260" text="Завершено" /><string id="forge_6be090825c99" text="Порядок" /><string id="forge_18f2a0947f9d" text="Заблокировано" /><string id="forge_54a0e8c17ebb" text="Ошибка" /><string id="forge_1993f23b0726" text="Нет записей журнала, соответствующих поиску." /><string id="forge_331e3ea43567" text="Очистите поле «Поиск / аргумент» и нажмите Ctrl+Enter, чтобы показать все доступные записи." /><string id="forge_05d3ec58206c" text="Фокус клавиатуры" /><string id="forge_9bae918add9a" text="Разделы" /><string id="forge_a4e733eebdd3" text="Workbench" /><string id="forge_fc8a8bfccc30" text="Current source" /><string id="forge_6b1f854a4eaa" text="Session and files" /><string id="forge_5cde40fd111d" text="Section tools" /><string id="forge_219c4a6c86a7" text="Results" /><string id="forge_a4fe65264ef7" text="Language" /><string id="forge_d68761cc1eb2" text="Text size" /><string id="forge_6bef4668924c" text="Рабочая среда разработчика" /><string id="forge_1c361d598197" text="Workbench sections" /><string id="forge_1ce46e1c33ba" text="Search or exact object/test ID" /><string id="forge_42bd9cd4555e" text="Test seed" /><string id="forge_e48fedcd517c" text="Operation in progress" /><string id="forge_06aa59d1fc7a" text="Report details" /><string id="forge_92c1cdfdf4cb" text="Включено" /><string id="forge_75081b593d15" text="Отключено" /><string id="forge_ced6bf7b296b" text="Выберите инструмент" /><string id="forge_a1c0492f16ec" text="Модули: проверьте зависимости.&#10;Инспектор: зафиксируйте состояние объекта.&#10;Тесты: проверьте расширение." /><string id="forge_0d8a6dd37429" text="Безопасно просматривайте данные. Тесты, изменяющие состояние, требуют режима тестирования; для кампании также нужна рабочая копия." /><string id="forge_b82e7a80f6b4" text="Ваша сессия разработки с первого взгляда." /><string id="forge_f167862fa57f" text="Ищите записи, собранные в этом сеансе. Оставьте поиск пустым, чтобы показать все." /><string id="forge_baf267e557d8" text="Измерения охватывают инструментированные операции, а не всю игру." /><string id="forge_ce02285cc14e" text="Work order" /><string id="forge_db798be1cd6f" text="Состояние отчета" /><string id="forge_6a7a26775330" text="Сохраненные данные" /><string id="forge_c2eb8cd9d956" text="Attention" /><string id="forge_794131b64bc2" text="Лаборатория повторов" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="Введите сохраненную последовательность события, затем запустите защищенное повторение." /><string id="forge_c8dae6371b33" text="Повтор" /><string id="forge_2d1e82553a41" text="Источник повтора" /><string id="forge_6b7609616c31" text="Результат повтора" /><string id="forge_ae02ff4ee2da" text="Режим повтора" /><string id="forge_274844a2a9d7" text="Повтор отклонен" /><string id="forge_ab9b00d2d398" text="Повтор завершен" /><string id="forge_19bc07d10e98" text="Выберите сохраненную последовательность события." /><string id="forge_63bfa59d261f" text="Нет доступных сохраненных событий." /><string id="forge_c490ac762d13" text="Повтор в игре использует существующие меры защиты режима тестирования и копии кампании." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="Проверяет только указанную сборку и регистрирует поддерживаемые контракты SDK." /><string id="forge_ec2d15a6c2b8" text="Объявляет отдельный prefab Gauntlet, который Forge может открыть как слой." /><string id="forge_4891dad02563" text="Объявляет команду Gauntlet без параметров и требуемый контекст." /><string id="forge_0f22b4474d14" text="Запрашивает у Forge открытие зарегистрированной страницы расширения." /><string id="forge_a105da0e865c" text="Читает ограниченные метаданные PE/.NET в фоне, не загружая и не запуская DLL. Изменение версии требует предварительного просмотра и создает проверенную копию с резервной копией и хешами." /><string id="forge_ed668f618580" text="Атрибуты проверяют метаданные, но не изолируют сторонний код. Команды остаются кодом автора и должны соблюдать правила главного потока Bannerlord." /><string id="forge_7398a2596036" text="Путь к сборке или номер" /><string id="forge_dd167905de0d" text="Версия" /><string id="forge_2ba785b2d3a4" text="Список установленных DLL" /><string id="forge_7d09a0fdc74d" text="Выбрать строку DLL" /><string id="forge_26c48e56ad62" text="Проверить метаданные" /><string id="forge_ef91046c4294" text="Предпросмотр версии" /><string id="forge_dbd8f023eda9" text="Применить к копии" /><string id="forge_0eac5d3fd9da" text="Рабочая область сборок" /><string id="forge_395b1be558b8" text="Открыть страницу расширения" /><string id="forge_a1155cbb1daf" text="Контекстная справка" /><string id="forge_789588bda2aa" text="Страницы расширений Gauntlet" /><string id="forge_b672f9bf0dab" text="Введите ID страницы в поле аргумента и нажмите «Открыть страницу расширения»." /><string id="forge_32eaf5cf96d5" text="Откройте контекстную справку для офлайн-подсказок SDK и рабочей области сборок." /><string id="forge_346f06362ca2" text="Справка по рабочей области сборок" /><string id="forge_0a10143c886e" text="Выведите список DLL, введите номер строки и выберите ее. Проверка читает только метаданные PE и не загружает и не запускает файл." /><string id="forge_c0287b2759d7" text="Для смены версии введите четыре числовых компонента, сначала проверьте предварительный просмотр, затем примените для создания копии в LocalAppData/CalradiaForge/AssemblyWorkbench." /><string id="forge_a75050e56e7d" text="Подписанные strong name и смешанные сборки отклоняются. Оригинал сохраняется; записываются резервная копия и хеш SHA-256." /><string id="forge_a2256b564db1" text="Справка SDK в игре" /><string id="forge_b5911a953b0d" text="Совпадающие строки не найдены." /><string id="forge_dd3b39dacbf7" text="РАСШИРЕННЫЙ SDK" /><string id="forge_f3bccf3efbfe" text="Проверка аудиоманифеста завершена." /><string id="forge_ee88528b0625" text="Аудиотест выполнен." /><string id="forge_153f0a2d00cb" text="Просмотрите более 110 расширенных инструментов SDK" /><string id="forge_04fb89acf8ae" text="ИСТОРИЯ КОМАНД" /><string id="forge_1671fd14dfa5" text="Оценка casus belli завершена." /><string id="forge_9768be40e931" text="Очистить историю" /><string id="forge_4e6e062d6524" text="Удаляет всю сохранённую историю команд." /><string id="forge_729f0343c990" text="Закрывает каталог SDK." /><string id="forge_af09632242f3" text="Скопировано в буфер обмена." /><string id="forge_1a5b5a6ad016" text="Моделирование преступности и подполья завершено." /><string id="forge_75a51e1c4583" text="Ctrl+F: ввод · Ctrl+Enter: обновить вывод" /><string id="forge_4e62272d6dc1" text="Ctrl+K: справка · Ctrl+W: наблюдение · Tab: фокус" /><string id="forge_1b497f9d7f85" text="Оценка династии и наследования завершена." /><string id="forge_b13945c508a8" text="Фильтр сброшен. Показаны все строки." /><string id="forge_055819ab7f57" text="Отфильтровано совпадающих строк: {0}." /><string id="forge_50ce67c7fc43" text="Куча очищена: освобождено {0:F1} МБ" /><string id="forge_6583c717f13e" text="История ▾" /><string id="forge_582f2cd9b20f" text="Мониторинг в реальном времени включён (интервал 1 с)" /><string id="forge_2d559fafb5c2" text="Мониторинг в реальном времени выключен" /><string id="forge_2780abe560d2" text="Загружает следующую команду из истории (стрелка вниз)." /><string id="forge_ed8b52d5e5c7" text="Загружает предыдущую команду из истории (стрелка вверх)." /><string id="forge_1c4c3d2a6aab" text="Проверка локализации завершена." /><string id="forge_f5b3e708c545" text="Открывает каталог расширенных инструментов SDK с поиском." /><string id="forge_0acff9a2de67" text="Отображаемый вывод очищен." /><string id="forge_298d79d4c832" text="Моделирование отряда завершено." /><string id="forge_66a024aea84a" text="Каталог SDK" /><string id="forge_50e8fa699d85" text="Проверка состояния сохранений пройдена." /><string id="forge_f4b0f74fd12a" text="Каркас создан. Сохраните его с помощью команды «Копировать в буфер обмена»." /><string id="forge_fb69d1d9a74d" text="Анализ осадной тактики завершён." /><string id="forge_78d49d020849" text="Открывает или закрывает список недавних команд." /><string id="forge_a006eefe667b" text="Показывает или скрывает справочник тактических сочетаний клавиш (Ctrl+K)." /><string id="forge_c5de2e25402f" text="Моделирование торговли завершено." /><string id="forge_05d04cc462be" text="[ ⌨ Клавиши ]" /><string id="forge_916497b4c2fd" text="Фокус на данных" /><string id="forge_9d67b6069665" text="Показать инструменты" /><string id="forge_3a738bcb53b2" text="Быстрая навигация" /><string id="forge_241bd2cd0c42" text="Активное представление" /><string id="forge_9b0f9e9587d9" text="Введите текст для поиска по всем маршрутам и инструментам SDK." /><string id="forge_2c326441d438" text="Подходящие маршруты не найдены." /><string id="forge_85ad813360db" text="Поиск по представлениям и инструментам SDK" /><string id="forge_ec7f4320f39d" text="↑/↓ Перемещение · Enter Открыть · Esc Закрыть · Ctrl+P Переключить" /><string id="forge_1810407f5ab7" text="Быстрые действия" /><string id="forge_512c84789fba" text="Перейти к поиску" /><string id="forge_2d8cafe0d1f8" text="Переводит фокус в поле поиска или аргумента текущего раздела." /><string id="forge_7a1f2a83aca9" text="Избранное" /><string id="forge_690dbe9dc099" text="Недавние" /><string id="forge_a98de9121cb4" text="Переключить мониторинг в реальном времени" /><string id="forge_5bc0aa08d678" text="Удалить из избранного" /><string id="forge_65b52e8c6521" text="Добавить в избранное" /><string id="forge_40f2c1871b3f" text="Используйте элементы управления этого представления для выполнения действий." /></strings></base>