/><string id="forge_f187f78e07ef" text="Снимки" /><string id="forge_2e41b118eb20" text="Зависимости" /><string id="forge_19fac1fc1f7b" text="Удалить снимок" /><string id="forge_4fd763173e46" text="Запустить серию" /><string id="forge_04aec871e37a" text="Найдите объект по типу и ID. Закрепите исходное состояние перед сравнением." /><string id="forge_ac76aefb08e7" text="Запустите один ID теста или пакет, разделённый запятыми. Пакеты останавливаются при первой ошибке." /><string id="forge_80ca8e50e6e5" text="Проверьте установленные модули без изменения файлов или настроек лаунчера." /><string id="forge_6d16fc3e9c38" text="Browse a live session or the current report. Export preserves the current report." /><string id="forge_442f6ea6fab1" text="Enable Live session to use game actions." /><string id="forge_81cfeb2db510" text="No records captured." /><string id="forge_371fa51b2bd8" text="Scan modules, open a report, or connect to Bannerlord to begin." /><string id="forge_16f776fa58d2" text="New report" /><string id="forge_967e1dd0e2fa" text="Captured live session" /><string id="forge_73d3559aa7c7" text="Снимок удалён" /><string id="forge_953f1b7e1234" text="Снимок не найден" /><string id="forge_0d7aa5e3fc18" text="Недопустимый контекст расширения" /><string id="forge_840f8e0862a9" text="Выберите от 1 до 50 тестов" /><string id="forge_dd9e54c609cb" text="Версия Native" /><string id="forge_85a39ab345d6" text="Да" /><string id="forge_1ea442a134b2" text="Нет" /><string id="forge_2b505597daa7" text="Любой" /><string id="forge_268286d2ef75" text="Кампания" /><string id="forge_e6b85bfbf550" text="Миссия" /><string id="forge_143b270a3260" text="Завершено" /><string id="forge_6be090825c99" text="Порядок" /><string id="forge_18f2a0947f9d" text="Заблокировано" /><string id="forge_54a0e8c17ebb" text="Ошибка" /><string id="forge_1993f23b0726" text="Нет записей журнала, соответствующих поиску." /><string id="forge_331e3ea43567" text="Очистите поле «Поиск / аргумент» и нажмите Ctrl+Enter, чтобы показать все доступные записи." /><string id="forge_05d3ec58206c" text="Фокус клавиатуры" /><string id="forge_9bae918add9a" text="Разделы" /><string id="forge_a4e733eebdd3" text="Workbench" /><string id="forge_fc8a8bfccc30" text="Current source" /><string id="forge_6b1f854a4eaa" text="Session and files" /><string id="forge_5cde40fd111d" text="Section tools" /><string id="forge_219c4a6c86a7" text="Results" /><string id="forge_a4fe65264ef7" text="Language" /><string id="forge_d68761cc1eb2" text="Text size" /><string id="forge_6bef4668924c" text="Рабочая среда разработчика" /><string id="forge_1c361d598197" text="Workbench sections" /><string id="forge_1ce46e1c33ba" text="Search or exact object/test ID" /><string id="forge_42bd9cd4555e" text="Test seed" /><string id="forge_e48fedcd517c" text="Operation in progress" /><string id="forge_06aa59d1fc7a" text="Report details" /><string id="forge_92c1cdfdf4cb" text="Включено" /><string id="forge_75081b593d15" text="Отключено" /><string id="forge_ced6bf7b296b" text="Выберите инструмент" /><string id="forge_a1c0492f16ec" text="Модули: проверьте зависимости.&#10;Инспектор: зафиксируйте состояние объекта.&#10;Тесты: проверьте расширение." /><string id="forge_0d8a6dd37429" text="Безопасно просматривайте данные. Тесты, изменяющие состояние, требуют режима тестирования; для кампании также нужна рабочая копия." /><string id="forge_b82e7a80f6b4" text="Ваша сессия разработки с первого взгляда." /><string id="forge_f167862fa57f" text="Ищите записи, собранные в этом сеансе. Оставьте поиск пустым, чтобы показать все." /><string id="forge_baf267e557d8" text="Измерения охватывают инструментированные операции, а не всю игру." /><string id="forge_ce02285cc14e" text="Work order" /><string id="forge_db798be1cd6f" text="Состояние отчета" /><string id="forge_6a7a26775330" text="Сохраненные данные" /><string id="forge_c2eb8cd9d956" text="Attention" /><string id="forge_794131b64bc2" text="Лаборатория повторов" /><string id="forge_662ba0a4a9c7" text="Replay selected event" /><string id="forge_2d7b86e71bba" text="Введите сохраненную последовательность события, затем запустите защищенное повторение." /><string id="forge_c8dae6371b33" text="Повтор" /><string id="forge_2d1e82553a41" text="Источник повтора" /><string id="forge_6b7609616c31" text="Результат повтора" /><string id="forge_ae02ff4ee2da" text="Режим повтора" /><string id="forge_274844a2a9d7" text="Повтор отклонен" /><string id="forge_ab9b00d2d398" text="Повтор завершен" /><string id="forge_19bc07d10e98" text="Выберите сохраненную последовательность события." /><string id="forge_63bfa59d261f" text="Нет доступных сохраненных событий." /><string id="forge_c490ac762d13" text="Повтор в игре использует существующие меры защиты режима тестирования и копии кампании." /><string id="forge_c224d4b803ff" text="Test permission" /><string id="forge_ac2a84de8323" text="Selected evidence" /><string id="forge_973a01c05845" text="No evidence selected" /><string id="forge_30d5679ba22a" text="Retained event sequence" /><string id="forge_2cd6bc90d003" text="Offline report" /><string id="forge_40fa9ec67900" text="{0} selected · {1} retained" /><string id="forge_3ea66d904744" text="Connect to a live session to replay retained events." /><string id="forge_5c8af69484dd" text="The connected game does not expose Replay Lab." /><string id="forge_a93d7ced1fd1" text="ForgeWeave Replay Lab reuses retained host events for controlled verification. It does not intercept methods or inject event data." /><string id="forge_f732d46f083f" text="Проверяет только указанную сборку и регистрирует поддерживаемые контракты SDK." /><string id="forge_ec2d15a6c2b8" text="Объявляет отдельный prefab Gauntlet, который Forge может открыть как слой." /><string id="forge_4891dad02563" text="Объявляет команду Gauntlet без параметров и требуемый контекст." /><string id="forge_0f22b4474d14" text="Запрашивает у Forge открытие зарегистрированной страницы расширения." /><string id="forge_a105da0e865c" text="Читает ограниченные метаданные PE/.NET в фоне, не загружая и не запуская DLL. Изменение версии требует предварительного просмотра и создает проверенную копию с резервной копией и хешами." /><string id="forge_ed668f618580" text="Атрибуты проверяют метаданные, но не изолируют сторонний код. Команды остаются кодом автора и должны соблюдать правила главного потока Bannerlord." /><string id="forge_7398a2596036" text="Путь к сборке или номер" /><string id="forge_dd167905de0d" text="Версия" /><string id="forge_2ba785b2d3a4" text="Список установленных DLL" /><string id="forge_7d09a0fdc74d" text="Выбрать строку DLL" /><string id="forge_26c48e56ad62" text="Проверить метаданные" /><string id="forge_ef91046c4294" text="Предпросмотр версии" /><string id="forge_dbd8f023eda9" text="Применить к копии" /><string id="forge_0eac5d3fd9da" text="Рабочая область сборок" /><string id="forge_395b1be558b8" text="Открыть страницу расширения" /><string id="forge_a1155cbb1daf" text="Контекстная справка" /><string id="forge_789588bda2aa" text="Страницы расширений Gauntlet" /><string id="forge_b672f9bf0dab" text="Введите ID страницы в поле аргумента и нажмите «Открыть страницу расширения»." /><string id="forge_32eaf5cf96d5" text="Откройте контекстную справку для офлайн-подсказок SDK и рабочей области сборок." /><string id="forge_346f06362ca2" text="Справка по рабочей области сборок" /><string id="forge_0a10143c886e" text="Выведите список DLL, введите номер строки и выберите ее. Проверка читает только метаданные PE и не загружает и не запускает файл." /><string id="forge_c0287b2759d7" text="Для смены версии введите четыре числовых компонента, сначала проверьте предварительный просмотр, затем примените для создания копии в LocalAppData/CalradiaForge/AssemblyWorkbench." /><string id="forge_a75050e56e7d" text="Подписанные strong name и смешанные сборки отклоняются. Оригинал сохраняется; записываются резервная копия и хеш SHA-256." /><string id="forge_a2256b564db1" text="Справка SDK в игре" /><string id="forge_b5911a953b0d" text="Совпадающие строки не найдены." /><string id="forge_dd3b39dacbf7" text="РАСШИРЕННЫЙ SDK" /><string id="forge_f3bccf3efbfe" text="Проверка аудиоманифеста завершена." /><string id="forge_ee88528b0625" text="Аудиотест выполнен." /><string id="forge_153f0a2d00cb" text="Просмотрите более 110 расширенных инструментов SDK" /><string id="forge_04fb89acf8ae" text="ИСТОРИЯ КОМАНД" /><string id="forge_1671fd14dfa5" text="Оценка casus belli завершена." /><string id="forge_9768be40e931" text="Очистить историю" /><string id="forge_4e6e062d6524" text="Удаляет всю сохранённую историю команд." /><string id="forge_729f0343c990" text="Закрывает каталог SDK." /><string id="forge_af09632242f3" text="Скопировано в буфер обмена." /><string id="forge_1a5b5a6ad016" text="Моделирование преступности и подполья завершено." /><string id="forge_75a51e1c4583" text="Ctrl+F: ввод · Ctrl+Enter: обновить вывод" /><string id="forge_4e62272d6dc1" text="Ctrl+K: справка · Ctrl+W: наблюдение · Tab: фокус" /><string id="forge_1b497f9d7f85" text="Оценка династии и наследования завершена." /><string id="forge_b13945c508a8" text="Фильтр сброшен. Показаны все строки." /><string id="forge_055819ab7f57" text="Отфильтровано совпадающих строк: {0}." /><string id="forge_50ce67c7fc43" text="Куча очищена: освобождено {0:F1} МБ" /><string id="forge_6583c717f13e" text="История ▾" /><string id="forge_582f2cd9b20f" text="Мониторинг в реальном времени включён (интервал 1 с)" /><string id="forge_2d559fafb5c2" text="Мониторинг в реальном времени выключен" /><string id="forge_2780abe560d2" text="Загружает следующую команду из истории (стрелка вниз)." /><string id="forge_ed8b52d5e5c7" text="Загружает предыдущую команду из истории (стрелка вверх)." /><string id="forge_1c4c3d2a6aab" text="Проверка локализации завершена." /><string id="forge_f5b3e708c545" text="Открывает каталог расширенных инструментов SDK с поиском." /><string id="forge_0acff9a2de67" text="Отображаемый вывод очищен." /><string id="forge_298d79d4c832" text="Моделирование отряда завершено." /><string id="forge_66a024aea84a" text="Каталог SDK" /><string id="forge_50e8fa699d85" text="Проверка состояния сохранений пройдена." /><string id="forge_f4b0f74fd12a" text="Каркас создан. Сохраните его с помощью команды «Копировать в буфер обмена»." /><string id="forge_fb69d1d9a74d" text="Анализ осадной тактики завершён." /><string id="forge_78d49d020849" text="Открывает или закрывает список недавних команд." /><string id="forge_a006eefe667b" text="Показывает или скрывает справочник тактических сочетаний клавиш (Ctrl+K)." /><string id="forge_c5de2e25402f" text="Моделирование торговли завершено." /><string id="forge_05d04cc462be" text="[ ⌨ Клавиши ]" /><string id="forge_71886b7929d2" text="Фильтровать текущий вывод, не изменяя аргумент инструмента." /><string id="forge_f5b680c59d2d" text="Фильтровать строки вывода..." /><string id="forge_d03ed87a54bf" text="Очистить фильтр вывода." /><string id="forge_c6ece04535b2" text="Нет строк вывода, соответствующих этому фильтру." /><string id="forge_03867aea70ac" text="Доказательства" /><string id="forge_78f6584233f0" text="Закрепить исходный вывод" /><string id="forge_11c819060809" text="Сравнить выводы" /><string id="forge_9a50b0844ced" text="Очистить исходный вывод" /><string id="forge_39f1002c9985" text="Исходный вывод" /><string id="forge_08c59e23faa9" text="Текущий вывод" /><string id="forge_1113401f812c" text="Исходный вывод закреплён." /><string id="forge_3fde84f2ab44" text="Закрепите исходный вывод перед сравнением." /><string id="forge_5d86a0faffd1" text="Нет текущего вывода для сравнения." /><string id="forge_6c1ac74796b8" text="Ни одна сторона не содержит вывода, соответствующего фильтру." /><string id="forge_bd1df295578a" text="Сравнение недоступно: достигнут настроенный предел входных данных или вычислений." /><string id="forge_ffd7d472607e" text="Объём вывода превышает пределы сравнения; исходная версия не изменена." /><string id="forge_88b85e285a97" text="Показать текущий вывод" /><string id="forge_e502caae4ef2" text="Закрепить текущий вывод как основу сравнения." /><string id="forge_f1bc98b71e17" text="Показать исходный и текущий вывод рядом." /><string id="forge_fd24a42a4fba" text="Вернуться к текущему выводу, не удаляя исходный." /><string id="forge_20a3d4005399" text="Очистить закреплённую исходную версию вывода." /><string id="forge_13d0d65407e2" text="Исходный вывод очищен." /><string id="forge_3ea6008c2f7d" text="Результаты тестов" /><string id="forge_c0220b5dd3c3" text="Последние результаты тестов" /><string id="forge_01258bd385ea" text="Открыть результаты тестов" /><string id="forge_c0dc59381184" text="Закрыть результаты тестов" /><string id="forge_66388b09af1b" text="Результаты тестов пока недоступны." /><string id="forge_5cd7bbf04dc0" text="Подробности результата теста" /><string id="forge_ecbc89cd37a0" text="Начало" /><string id="forge_1de3df70ddf4" text="Шаги" /><string id="forge_25f08afdd4ca" text="Ошибка очистки" /><string id="forge_9ed6fabb9d04" text="Показаны результаты ({0}) из последнего ответа теста." /><string id="forge_43878b2de274" text="Выберите результат, чтобы посмотреть подробности." /><string id="forge_4a5c744c9473" text="ID теста" /><string id="forge_920e413c7d41" text="Статус" /><string id="forge_4fc52a3c4c55" text="Длительность" /><string id="forge_d7c2213d598e" text="Read-only inventory of active Harmony patches in already-loaded assemblies." /><string id="forge_73a17ab264ba" text="Patch Preflight: Read-only structural check of declared targets and callback references; it never applies patches or invokes callbacks." /><string id="forge_1f256bba1a1f" text="ForgeWeave: Event recording and sequence replay. Harmony Atlas is a separate read-only inventory; Patch Preflight checks blueprint declarations without applying patches." /><string id="forge_a672730bbf7a" text="Event Replay &amp; Patch Diagnostics" /><string id="forge_f264069aa903" text="2. Patch Blueprint Review: Run cf.patch_preflight to review pending declarations. It does not apply patches; applying a Forge method replacement requires a separate explicit opt-in." /><string id="forge_c2aab085005d" text="ForgeWeave Event Pipeline: Deterministic event recording and sequence replay. Harmony diagnostics and Patch Blueprint Preflight are separate tools." /><string id="forge_71f2228b1b4c" text="1. Forge method replacement requires a separate explicit request; declared hook kinds unsupported by the backend remain metadata. Patch Preflight is read-only and does not invoke callback code. Keep ForgeWeave event listeners non-serialized with AddNonSerializedListener." /><string id="forge_0411fe03a551" text="Список хуков" /><string id="forge_b184dfdeabb9" text="Следующий хук" /><string id="forge_333cac9ef3f2" text="Проверить выбранные" /><string id="forge_d938e481a39f" text="Предпросмотр применения" /><string id="forge_6af44eb7d360" text="Предпросмотр отмены" /><string id="forge_b49a9604ce16" text="Подтвердить действие" /><string id="forge_8639d4025a2a" text="Одобрить показанный план хуков" /><string id="forge_c489b8dfe2af" text="Выбранный хук" /><string id="forge_916497b4c2fd" text="Фокус на данных" /><string id="forge_9d67b6069665" text="Показать инструменты" /><string id="forge_3a738bcb53b2" text="Быстрая навигация" /><string id="forge_241bd2cd0c42" text="Активное представление" /><string id="forge_9b0f9e9587d9" text="Введите текст для поиска по всем маршрутам и инструментам SDK." /><string id="forge_2c326441d438" text="Подходящие маршруты не найдены." /><string id="forge_85ad813360db" text="Поиск по представлениям и инструментам SDK" /><string id="forge_ec7f4320f39d" text="↑/↓ Перемещение · Enter Открыть · Esc Закрыть · Ctrl+P Переключить" /><string id="forge_1810407f5ab7" text="Быстрые действия" /><string id="forge_512c84789fba" text="Перейти к поиску" /><string id="forge_2d8cafe0d1f8" text="Переводит фокус в поле поиска или аргумента текущего раздела." /><string id="forge_7a1f2a83aca9" text="Избранное" /><string id="forge_690dbe9dc099" text="Недавние" /><string id="forge_a98de9121cb4" text="Переключить мониторинг в реальном времени" /><string id="forge_5bc0aa08d678" text="Удалить из избранного" /><string id="forge_65b52e8c6521" text="Добавить в избранное" /><string id="forge_40f2c1871b3f" text="Используйте элементы управления этого представления для выполнения действий." /><string id="forge_d367f2ccfaa8" text="Компоновщик страниц Gauntlet" /><string id="forge_e2fdd460c82f" text="Собирайте страницу Gauntlet визуально, просматривайте компоненты с привязкой к данным и создавайте комплект XML, ViewModel, локализации и интеграции." /><string id="forge_02660ffe391c" text="Заголовок страницы" /><string id="forge_b34f17f02ecf" text="Заголовок" /><string id="forge_71988c4d8e08" text="Текст" /><string id="forge_41f37a9431ba" text="Редактируемое поле" /><string id="forge_707eab0c23ec" text="Кнопка" /><string id="forge_c216155f49fd" text="Статус или показатель" /><string id="forge_6f202f54a7b2" text="Список" /><string id="forge_3d03a1dea561" text="Переключатель" /><string id="forge_88bbc75dfba2" text="Индикатор выполнения" /><string id="forge_f02a172a3535" text="Селектор" /><string id="forge_4aa30e90d01d" text="Добавить компонент" /><string id="forge_8ee8724b2eb8" text="Компоненты страницы" /><string id="forge_b4a62fe05b1f" text="Выбранный компонент" /><string id="forge_9af898736805" text="Предпросмотр Gauntlet" /><string id="forge_29d7b5f6e9b6" text="Созданный пакет" /><string id="forge_77d41f454f43" text="Добавьте компонент, чтобы начать. В предпросмотре используются локальные демонстрационные данные." /><string id="forge_b240e1cad8d4" text="Подпись компонента" /><string id="forge_4e0ef6838f01" text="Пример текста или значения" /><string id="forge_75333e0740e5" text="Варианты через |" /><string id="forge_986787d7eaa3" text="Выполнение (0–100)" /><string id="forge_3de100106dd4" text="Сохранить черновик" /><string id="forge_49e49bb4401e" text="Создать" /><string id="forge_c1ad1e107c3e" text="Скопировать пакет" /><string id="forge_4452cbdbee0f" text="Изменить черновик" /><string id="forge_b9ddfbc87baf" text="Предыдущий компонент" /><string id="forge_7c47b2a48c11" text="Следующий компонент" /><string id="forge_c66feb5eb8f2" text="Переместить вверх" /><string id="forge_40bb50da160c" text="Переместить вниз" /><string id="forge_c3812fc4acb8" text="Удалить" /><string id="forge_e2cca9bf05d0" text="Проверить кнопку" /><string id="forge_62e4fe7b43eb" text="Переключить образец" /><string id="forge_423c59e4a296" text="Следующий вариант" /><string id="forge_d72b12535333" text="Компонент не выбран" /><string id="forge_a1daa907abcb" text="Нет сохранённого черновика." /><string id="forge_722342249d73" text="Черновик загружен." /><string id="forge_cb386356fd99" text="Сохранённый черновик повреждён. Он останется на месте до сохранения." /><string id="forge_57a555c031cd" text="Сохранённый черновик больше 64 КиБ. Он останется до сохранения." /><string id="forge_9162390fb0c1" text="В черновике используется неподдерживаемая версия. Он останется до сохранения." /><string id="forge_8d3a00d1ddd0" text="Не удалось прочитать сохранённый черновик. Он останется до сохранения." /><string id="forge_361f1dd9ca67" text="Сначала откройте компоновщик страниц Gauntlet." /><string id="forge_6fa7a61c10ff" text="В черновике может быть не более 12 компонентов." /><string id="forge_6099d02d0b8d" text="Для списков и селекторов требуется от 1 до 8 непустых вариантов через |." /><string id="forge_f87812e34aa1" text="Для списков и селекторов требуется от 1 до 8 вариантов." /><string id="forge_5d50dbf6b3a7" text="Прогресс должен быть целым числом от 0 до 100." /><string id="forge_be997844b2a8" text="Черновик сохранён." /><string id="forge_020050843468" text="Привязки и локализация прошли проверку." /><string id="forge_e7220e0d69d2" text="В черновике есть несохранённые изменения." /><string id="forge_aeff316684da" text="Добавьте хотя бы один компонент перед созданием пакета." /><string id="forge_35f8ba6dfcf0" text="Созданный пакет не прошёл проверку привязок и локализации." /><string id="forge_599dfa4801a2" text="Не удалось сохранить черновик." /><string id="forge_924aa4d7edb4" text="Черновик превышает ограничение файла 64 КиБ." /><string id="forge_57d5c15b5e2d" text="Путь к черновику недоступен." /><string id="forge_657477132801" text="Варианты можно задавать только для списков и селекторов." /><string id="forge_498080a9115c" text="Черновик содержит недопустимый тип компонента или ID." /><string id="forge_9ee03c70fadf" text="Версия схемы черновика не поддерживается." /><string id="forge_5d2fc65f1142" text="Черновик пуст." /><string id="forge_08a6257e9d21" text="Компонент может содержать не более 8 вариантов." /><string id="forge_70dcda47de4e" text="Конструктор правил кампании" /><string id="forge_321f020a4ce2" text="Составьте правила кампании с образцовыми данными, затем создайте проверенный пакет безсостоянного поведения." /><string id="forge_010a40357b5f" text="Логическое условие не может иметь значения." /><string id="forge_f39bee9f3ca6" text="Условие несовместимо со своим событием." /><string id="forge_8dcb50fc7b1a" text="Проект может содержать не более восьми правил." /><string id="forge_4ba8537b033d" text="Числовое условие требует значения от 1 до 1000." /><string id="forge_d45d90cabed2" text="Правило имеет недопустимый идентификатор, событие, действие или цель." /><string id="forge_d5eefa23019a" text="Добавьте условие в группу А перед группой Б." /><string id="forge_cf0b6b136ea6" text="Для начала добавьте правило. Предварительный просмотр использует только образцы данных." /><string id="forge_cde7ea4cd86b" text="Прежде чем создавать, добавьте хотя бы одно правило." /><string id="forge_60a0d83510ea" text="Добавить условие" /><string id="forge_a27cff51a2e0" text="Добавить правило" /><string id="forge_de9f057a471c" text="Всегда" /><string id="forge_49e96d7cdf58" text="Сумма" /><string id="forge_3c3397641e64" text="Изменить условие" /><string id="forge_91eeb183b2ff" text="Влияние изменений" /><string id="forge_75cbb047f130" text="Изменить отношение игрока" /><string id="forge_171d4cb713f8" text="Смена события очищает обе группы." /><string id="forge_775fd55e649d" text="Клан принадлежит игроку" /><string id="forge_9b11666b6ae1" text="Ежедневное событие для героя: правило проверяется для героя из события. Действия выполняются только при совпадении условий; награды игроку могут повторяться для каждого подходящего героя." /><string id="forge_e31958c93601" text="Ежедневное событие для поселения: правило проверяется для поселения из события. Действия выполняются только при совпадении условий; награды игроку могут повторяться для каждого подходящего поселения." /><string id="forge_28c32f23e317" text="Повреждён; сохранён до сохранения." /><string id="forge_d2e051d82a96" text="Более 64 КиБ; сохранён до сохранения." /><string id="forge_93a16ebeaea9" text="Каждая группа принимает не более трех условий." /><string id="forge_93b97256bb9d" text="Сущность события" /><string id="forge_1b60c83089b9" text="Не удалось создать контракт без сохранения состояния и реентерабельности." /><string id="forge_89011acab2f1" text="Грант золото" /><string id="forge_6893ea9b6b16" text="Даровать известность" /><string id="forge_180dae1a1c5b" text="Герой жив" /><string id="forge_45bea9354226" text="Герой — игрок" /><string id="forge_3ec3b2d0596d" text="Уровень героя минимум" /><string id="forge_da219f1ccb52" text="Если · группа А (все)" /><string id="forge_e0d150dc1552" text="Следующее правило" /><string id="forge_326a1b09bf99" text="Нет сохраненного проекта правила." /><string id="forge_291101a07fe9" text="Оператор" /><string id="forge_3043c0eb167b" text="Или · группа Б (все)" /><string id="forge_028f690119e6" text="Отряд является главным отрядом" /><string id="forge_64aee8c6cbd0" text="Игрок" /><string id="forge_38f0f61fa476" text="Только предварительный просмотр. Ни одна кампания не проводилась." /><string id="forge_0f74be93a63e" text="Предыдущее правило" /><string id="forge_5ac0b06fc9f0" text="Удалить условие" /><string id="forge_3fab7379af90" text="Удалить правило" /><string id="forge_2f6f266646cb" text="Сумма правила выходит за пределы поддерживаемого диапазона." /><string id="forge_8c895b784dba" text="Черновик правила загружен." /><string id="forge_05e3e42d3d1c" text="Черновик правила сохранен." /><string id="forge_40274c011d19" text="Порядок правил" /><string id="forge_b5776d9cbb05" text="Не удалось создать пакет правил." /><string id="forge_399093e8ed95" text="Пакет правил проверен. Никакие игровые действия не выполнялись." /><string id="forge_a45743db21e5" text="Правила проверены. Никакие игровые действия не выполнялись." /><string id="forge_b26c8c8ab890" text="Пример данных: герой не является игроком, жив, уровень 20, клан не принадлежит игроку, город, прирост навыка 5, отряд не является основным." /><string id="forge_a5ae949b24f5" text="Пример результата: действие будет пропущено." /><string id="forge_a7cd34455782" text="Пример результата: действие будет запущено." /><string id="forge_39d399369a10" text="Пример предварительного просмотра" /><string id="forge_863b9cc114c8" text="Выберите правило, чтобы просмотреть его." /><string id="forge_b59307d2ae21" text="Выбранное правило" /><string id="forge_14c1f63bbfa2" text="Поселение – это город" /><string id="forge_392173b14d0e" text="Как минимум прибавка к навыкам" /><string id="forge_978354db0c00" text="Цель" /><string id="forge_b11a7c4d5e21" text="Черновик превышает 64 КиБ." /><string id="forge_74f1e3bc7867" text="Не удалось сохранить черновик правила." /><string id="forge_486039c41213" text="Вторая группа условий требует наличия первой группы." /><string id="forge_61cdd8ae91f3" text="Тогда · действие" /><string id="forge_f23bd6366dda" text="Порог (1-1000)" /><string id="forge_d352fbd978e5" text="Не читается; сохранён до сохранения." /><string id="forge_f59eb1261ce0" text="Несохранённые изменения черновика." /><string id="forge_920cfe7e816e" text="Начальное правило не сохранено." /><string id="forge_37b7323f9809" text="Версия не поддерживается; файл сохранён." /><string id="forge_91701514da73" text="Неподдерживаемый или пустой проект правила." /><string id="forge_40611abbdda2" text="Подтвердить" /><string id="forge_caa26ffefa3e" text="Когда · событие" /><string id="forge_b86d4fde1f8f" text="Когда · событие (нажмите, чтобы изменить)" /></strings></base>