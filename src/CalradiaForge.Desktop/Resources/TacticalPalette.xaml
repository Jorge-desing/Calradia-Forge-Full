<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Theme tokens are values, not decoration. Controls consume the named brushes in App.xaml. -->
  <Color x:Key="Palette.Coal">#0D1714</Color>
  <Color x:Key="Palette.DeepPine">#13231E</Color>
  <Color x:Key="Palette.Tempered">#29463A</Color>
  <Color x:Key="Palette.Brass">#C7A45A</Color>
  <Color x:Key="Palette.Verdigris">#6FB183</Color>
  <Color x:Key="Palette.Ember">#BC6542</Color>
  <Color x:Key="Palette.Paper">#F1E6C8</Color>
  <Color x:Key="Palette.Ink">#1A241E</Color>
  <Color x:Key="Palette.LogoText">#F1E6C8</Color>
  <Color x:Key="Palette.Muted">#B6C7B9</Color>
  <Color x:Key="Palette.Border">#426253</Color>
  <Color x:Key="Palette.Input">#0B1210</Color>
  <Color x:Key="Palette.Focus">#F1E6C8</Color>
  <Color x:Key="Palette.Success">#6FB183</Color>
  <Color x:Key="Palette.Warning">#D99A57</Color>
  <Color x:Key="Palette.Empty">#6C8276</Color>
  <Color x:Key="Palette.RailSurface">#10201B</Color>
  <Color x:Key="Palette.CardHighlight">#1D352B</Color>
  <Color x:Key="Palette.ComboHover">#2D5042</Color>
  <Color x:Key="Palette.ComboHoverText">#FFF5D8</Color>
  <Color x:Key="Palette.ComboSelected">#3E6352</Color>
  <Color x:Key="Palette.ComboSelectedText">#FFF9E9</Color>
  <Color x:Key="Palette.CaptionControl">#13231E</Color>
  <Color x:Key="Palette.CaptionHover">#29463A</Color>
  <Color x:Key="Palette.CaptionCloseHover">#99462F</Color>
  <Color x:Key="Palette.DisabledButtonSurface">#13231E</Color>
  <Color x:Key="Palette.DisabledButtonText">#B6C7B9</Color>
  <Color x:Key="Palette.DisabledButtonBorder">#829487</Color>
  <!-- Dynamic layout and state tokens keep scale and focus consistent across every page. -->
  <sys:Double x:Key="Token.Radius">4</sys:Double>
  <sys:Double x:Key="Token.Gutter">12</sys:Double>
  <Thickness x:Key="Token.Inset.Compact">8,5</Thickness>
  <Thickness x:Key="Token.Inset.Card">12</Thickness>
  <Thickness x:Key="Token.Inset.Rail">16</Thickness>
  <Thickness x:Key="Token.Inset.Header">12,10</Thickness>
  <Thickness x:Key="Token.Inset.Button">12,7</Thickness>
  <Thickness x:Key="Token.FocusThickness">2</Thickness>
  <sys:Double x:Key="Token.BodyFont">13</sys:Double>
  <sys:Double x:Key="Token.TitleFont">27</sys:Double>
  <sys:Double x:Key="Token.HeadingFont">13</sys:Double>
  <sys:Double x:Key="Token.LabelFont">10</sys:Double>
  <sys:Double x:Key="Token.CodeFont">12</sys:Double>
  <sys:Double x:Key="Token.RailWidth">300</sys:Double>
  <sys:Double x:Key="Token.HistoryHeight">142</sys:Double>
  <sys:Double x:Key="Token.SmallHistoryHeight">96</sys:Double>
  <sys:Double x:Key="Token.FocusOpacity">0.95</sys:Double>
  <sys:Double x:Key="Token.StatusIconOpacity">0.48</sys:Double>
  <sys:Double x:Key="Token.CaptionHeight">42</sys:Double>
  <!-- Brushes live with each palette so replacing its merged dictionary updates WPF DynamicResource consumers. -->
  <SolidColorBrush x:Key="CoalBrush" Color="{StaticResource Palette.Coal}"/>
  <SolidColorBrush x:Key="DeepPineBrush" Color="{StaticResource Palette.DeepPine}"/>
  <SolidColorBrush x:Key="TemperedBrush" Color="{StaticResource Palette.Tempered}"/>
  <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource Palette.Brass}"/>
  <SolidColorBrush x:Key="VerdigrisBrush" Color="{StaticResource Palette.Verdigris}"/>
  <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Palette.Ember}"/>
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Palette.Paper}"/>
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Palette.Ink}"/>
  <SolidColorBrush x:Key="LogoTextBrush" Color="{StaticResource Palette.LogoText}"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Palette.Muted}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Palette.Border}"/>
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource Palette.Input}"/>
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource Palette.Focus}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Palette.Success}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Palette.Warning}"/>
  <SolidColorBrush x:Key="EmptyBrush" Color="{StaticResource Palette.Empty}"/>
  <SolidColorBrush x:Key="RailSurfaceBrush" Color="{StaticResource Palette.RailSurface}"/>
  <SolidColorBrush x:Key="CardHighlightBrush" Color="{StaticResource Palette.CardHighlight}"/>
  <SolidColorBrush x:Key="ComboHoverBrush" Color="{StaticResource Palette.ComboHover}"/>
  <SolidColorBrush x:Key="ComboHoverTextBrush" Color="{StaticResource Palette.ComboHoverText}"/>
  <SolidColorBrush x:Key="ComboSelectedBrush" Color="{StaticResource Palette.ComboSelected}"/>
  <SolidColorBrush x:Key="ComboSelectedTextBrush" Color="{StaticResource Palette.ComboSelectedText}"/>
  <SolidColorBrush x:Key="TitleBarControlBrush" Color="{StaticResource Palette.CaptionControl}"/>
  <SolidColorBrush x:Key="TitleBarControlHoverBrush" Color="{StaticResource Palette.CaptionHover}"/>
  <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="{StaticResource Palette.CaptionCloseHover}"/>
  <SolidColorBrush x:Key="DisabledButtonSurfaceBrush" Color="{StaticResource Palette.DisabledButtonSurface}"/>
  <SolidColorBrush x:Key="DisabledButtonTextBrush" Color="{StaticResource Palette.DisabledButtonText}"/>
  <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="{StaticResource Palette.DisabledButtonBorder}"/>
  <SolidColorBrush x:Key="TitleBarGlyphBrush" Color="{StaticResource Palette.Paper}"/>
  <SolidColorBrush x:Key="TitleBarHoverGlyphBrush" Color="{StaticResource Palette.Paper}"/>
  <SolidColorBrush x:Key="TitleBarCloseHoverGlyphBrush" Color="{StaticResource Palette.Paper}"/>
  <Visibility x:Key="DecorativeTextureVisibility">Visible</Visibility>
  <sys:Double x:Key="Token.RailIllustrationOpacity">0.18</sys:Double>
  <Visibility x:Key="TitleBarHeraldicMarkVisibility">Visible</Visibility>
  <Visibility x:Key="TitleBarJournalMarkVisibility">Collapsed</Visibility>
  <Visibility x:Key="HeaderImageVisibility">Visible</Visibility>
  <Visibility x:Key="HeaderFallbackVisibility">Collapsed</Visibility>
  <SolidColorBrush x:Key="PineBrush" Color="{StaticResource Palette.DeepPine}"/>
  <SolidColorBrush x:Key="QuietBrassBrush" Color="{StaticResource Palette.Brass}"/>
  <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource Palette.Input}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Palette.Paper}"/>
  <SolidColorBrush x:Key="SteelBorderBrush" Color="{StaticResource Palette.Border}"/>
  <ImageBrush x:Key="Surface.MaterialTexture" ImageSource="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/Optimized/war-table-illustrated-cloth.png" Stretch="UniformToFill" Opacity="0.04"/>
  <ImageBrush x:Key="TitleBarMaterialTexture" ImageSource="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/Optimized/titlebar-embroidered-cloth.png" Stretch="UniformToFill" Opacity="0.22"/>
  <DrawingBrush x:Key="TitleBarSurfaceBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Brush="{DynamicResource DeepPineBrush}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
      <GeometryDrawing Brush="{StaticResource TitleBarMaterialTexture}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="FrameSurfaceBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{DynamicResource DeepPineBrush}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
        <GeometryDrawing Brush="{StaticResource Surface.MaterialTexture}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="NavigationSurfaceBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox" Stretch="Fill">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{DynamicResource RailSurfaceBrush}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
        <GeometryDrawing Brush="{StaticResource Surface.MaterialTexture}" Geometry="M 0,0 H 1 V 1 H 0 Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="FrameSurfaceSolidBrush" Color="{StaticResource Palette.DeepPine}"/>
  <SolidColorBrush x:Key="NavigationSurfaceSolidBrush" Color="{StaticResource Palette.RailSurface}"/>
  <SolidColorBrush x:Key="TitleBarSurfaceSolidBrush" Color="{StaticResource Palette.DeepPine}"/>
</ResourceDictionary>
