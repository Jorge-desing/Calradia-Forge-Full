              <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"><Run Text="{DynamicResource Viz.Workshop.RebellionRiskLabel}"/><Run Text=": 8.6%"/></TextBlock>
