<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation" xmlns:services="clr-namespace:CalradiaForge.Desktop.Services" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="TroopTreeVisualizerDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.crossed_swords}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="TACTICAL TROOP PROGRESSION HIERARCHY (6-TIER ACYCLIC DAG)" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding TroopTreeDashboard.Culture}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="22,1,0,0" Text="{Binding TroopTreeDashboard.ArchetypeSummary}"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding TroopTreeDashboard.StudioCaveat}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="1" Padding="6,2" VerticalAlignment="Center">
           <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="12 ARCHETYPES · 0 CYCLES"/>
          </Border>
         </Grid>
        </Border>
        <!-- Body: Troop Tree Branches -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
          <!-- Column: Levies (Tier I) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="170">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center" Text="TIER I · RECRUITS"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6" Padding="6">
             <StackPanel>
              <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Recruit"/>
              <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Text="Common Levies · Lvl 6"/>
              <TextBlock FontSize="9" Foreground="{DynamicResource BrassBrush}" Margin="0,3,0,0" Text="HP: 100 · Wage: 2d · Cost: 20d"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="Equip: Spear, Sickle"/>
             </StackPanel>
            </Border>
            <TextBlock FontSize="9" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center" Text="─────── ⯈ Upgrades"/>
           </StackPanel>
          </Border>
          <!-- Column: Core Line (Tier II-III) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="190">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center" Text="TIER II-III · INFANTRY &amp; ARCHERS"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Infantryman [T2]"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" Text="HP: 110 · Wage: 4d · Cost: 50d"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="⯈ Vet. Infantryman [T3] / Menavliaton"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Archer [T2]"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" Text="HP: 100 · Wage: 4d · Cost: 50d"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="⯈ Vet. Archer [T3] / Crossbowman"/>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
          <!-- Column: Elite Veteran Branch (Tier IV) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="200">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="TIER IV · ELITE SPECIALISTS"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Legionary"/>
              <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="★ HEAVY SHIELDWALL"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="HP: 130 · Wage: 11d · Cost: 200d"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Elite Menavliaton"/>
              <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource EmberBrush}" Text="★ ANTI-CAVALRY"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="HP: 125 · Wage: 11d · Cost: 200d"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Padding="5">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Palatine Guard"/>
              <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="★ COMPOSITE BOW"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="HP: 120 · Wage: 11d · Cost: 200d"/>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
          <!-- Column: Noble Dynastic Line (Tier II-VI) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="4" Padding="8" Width="210">
           <StackPanel>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="NOBLE LINE · CATAPHRACTS (T2-T6)"/>
            </Border>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Text="Imperial Vigla Recruit [T2]"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="⯈ Equite [T3] ⯈ Heavy Horseman [T4]"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="3" Padding="6">
             <StackPanel>
              <StackPanel Orientation="Horizontal">
               <Path Data="{StaticResource GameIcon.knight_banner}" Fill="{DynamicResource BrassBrush}" Height="13" Margin="0,0,4,0" Stretch="Uniform" Width="13"/>
               <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="Imperial Elite Cataphract [T6]"/>
              </StackPanel>
              <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Margin="0,2,0,0" Text="★ BARDED WARHORSE &amp; LANCE"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="HP: 160 · Level: 31 · Wage: 24d · Cost: 450d"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="Armor: Head 48 · Body 68 · Leg 44"/>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </Grid></DataTemplate>
  <DataTemplate x:Key="AudioMixerInspectorDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.gears}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="TACTICAL AUDIO STUDIO &amp; WAVEFORM ANALYZER" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding AudioStudioDashboard.AudioFormat}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="22,1,0,0" Text="{Binding AudioStudioDashboard.DurationText}"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding AudioStudioDashboard.StudioCaveat}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="1" Padding="6,2" VerticalAlignment="Center">
           <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="0 DIGITAL CLIPPING"/>
          </Border>
         </Grid>
        </Border>
        <!-- Body: Equalizer, Oscilloscope Waveform & VU Meters -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="180"/>
         </Grid.ColumnDefinitions>
         <!-- 5-Band Equalizer Spectrum -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="0" Margin="0,0,8,0" Padding="8">
          <StackPanel>
           <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,6" Text="SPECTRAL EQUALIZER"/>
           <ItemsControl ItemsSource="{Binding AudioStudioDashboard.Bands}">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Grid Margin="0,2">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
               </Grid.ColumnDefinitions>
               <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
               <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Grid.Column="1" Height="8" Margin="4,0" VerticalAlignment="Center">
                <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="8" HorizontalAlignment="Left" Width="{Binding Height}"/>
               </Border>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Dbfs}" VerticalAlignment="Center"/>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </Border>
         <!-- Oscilloscope Waveform Canvas -->
         <Border Background="#060907" BorderBrush="{DynamicResource SteelBorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="1" Margin="0,0,8,0" Padding="8">
          <DockPanel LastChildFill="True">
           <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="ACOUSTIC WAVEFORM ENVELOPE (TIME DOMAIN)"/>
            <TextBlock FontSize="9" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Right" Text="PEAK: -1.4 dBFS"/>
           </Grid>
           <TextBlock DockPanel.Dock="Bottom" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Text="0.0s ──────────────────────── 1.42s"/>
           <Grid Height="90" VerticalAlignment="Center">
            <Line Stroke="{DynamicResource SteelBorderBrush}" StrokeDashArray="2,2" StrokeThickness="1" X1="0" X2="400" Y1="45" Y2="45"/>
            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding AudioStudioDashboard.Waveform}">
             <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"/></ItemsPanelTemplate>
             </ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate>
              <DataTemplate>
               <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="1" Height="{Binding Height}" Margin="2,0" Opacity="0.9" VerticalAlignment="Center" Width="10"/>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </Grid>
          </DockPanel>
         </Border>
         <!-- VU Peak & Headroom Meters -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="2" Padding="8">
          <StackPanel>
           <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,6" Text="OUTPUT VU METERS"/>
           <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="LEFT CHANNEL (L)"/>
           <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Height="10" Margin="0,2,0,6">
            <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="10" HorizontalAlignment="Left" Width="135"/>
           </Border>
           <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="RIGHT CHANNEL (R)"/>
           <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Height="10" Margin="0,2,0,8">
            <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="10" HorizontalAlignment="Left" Width="128"/>
           </Border>
           <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Padding="4,3">
            <StackPanel>
             <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="HEADROOM: +1.4 dB"/>
             <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="SPATIAL: 3D Mission"/>
            </StackPanel>
           </Border>
          </StackPanel>
         </Border>
        </Grid>
       </Grid></DataTemplate>
  <DataTemplate x:Key="WorkshopSimulatorDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.gears}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="CALRADIA EQUILIBRIUM · WORKSHOP ENTERPRISE SIMULATOR" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding WorkshopDashboard.Settlement}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="22,1,0,0" Text="Scope: 30-Day Economic Amortization · 7 Enterprises Simulated"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding WorkshopDashboard.StudioCaveat}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="1" Padding="6,2" VerticalAlignment="Center">
           <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="SILVERSMITH OPTIMAL (+340d)"/>
          </Border>
         </Grid>
        </Border>
        <!-- Body: 7 Enterprises Comparative Profit Bars + Civic Equilibrium -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
         </Grid.ColumnDefinitions>
         <!-- Enterprise Profitability Bars -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="0" Margin="0,0,8,0" Padding="8">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
           <ItemsControl ItemsSource="{Binding WorkshopDashboard.Enterprises}">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Grid Margin="0,3">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="70"/>
               </Grid.ColumnDefinitions>
               <StackPanel Grid.Column="0">
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="{Binding Name}"/>
                <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Input}"/>
               </StackPanel>
               <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Grid.Column="1" Height="12" Margin="6,0" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrassBrush}" CornerRadius="2" Height="12" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
               </Border>
               <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Grid.Column="2" Text="{Binding ProfitText}" VerticalAlignment="Center"/>
               <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Grid.Column="3" HorizontalAlignment="Right" Text="{Binding Payback}" VerticalAlignment="Center"/>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </ScrollViewer>
         </Border>
         <!-- Civic Equilibrium KPI Card -->
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource SteelBorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="1" Padding="8">
          <StackPanel>
           <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,6" Text="CIVIC EQUILIBRIUM &amp; RISK"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Text="Prosperity: 5,420 (+4.2/day)"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Margin="0,2,0,0" Text="Civic Loyalty: 64.0 / 100"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Margin="0,2,0,0" Text="Security Score: 72.0 / 100"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource VerdigrisBrush}" Margin="0,2,0,0" Text="Food Storage: 184 (+14/d Surplus)"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" Text="Garrison: 165 Regulars"/>
           <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,8,0,0" Padding="4,3">
            <StackPanel>
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="REBELLION RISK: 8.6%"/>
             <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="Stable · Risk threshold: 45%"/>
            </StackPanel>
           </Border>
          </StackPanel>
         </Border>
        </Grid>
       </Grid></DataTemplate>
  <DataTemplate x:Key="AgentMemoryInspectorDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.scroll_unfurled}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="CoALA NPC COGNITIVE ARCHITECTURE INSPECTOR" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding AgentMemoryDashboard.CapacitySummary}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource VerdigrisBrush}" Margin="22,1,0,0" Text="{Binding AgentMemoryDashboard.ActiveClusterOverview}"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding AgentMemoryDashboard.StudioCaveat}" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- Agent Switcher Pills -->
          <ItemsControl Grid.Column="1" ItemsSource="{Binding AgentMemoryDashboard.Agents}" VerticalAlignment="Center">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Button Command="{Binding DataContext.AgentMemoryDashboard.SelectAgentCommand, RelativeSource={RelativeSource AncestorType=Border}}" CommandParameter="{Binding}" FontSize="8" Margin="2,0" Padding="5,2">
              <TextBlock Text="{Binding Name}"/>
             </Button>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Grid>
        </Border>
        <!-- Body: 3 Cognitive Memory Tiers -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <!-- Tier 1: Semantic Memory -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="0" Margin="0,0,6,0" Padding="8">
          <DockPanel LastChildFill="True">
           <TextBlock DockPanel.Dock="Top" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,4" Text="TIER 1 · SEMANTIC MEMORY (FACTS &amp; TTL)"/>
           <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" DockPanel.Dock="Top" Margin="0,0,0,4" Padding="4,2">
            <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="{Binding AgentMemoryDashboard.SelectedAgent.WorkingMemory}" TextWrapping="Wrap"/>
           </Border>
           <ItemsControl ItemsSource="{Binding AgentMemoryDashboard.SelectedAgent.SemanticFacts}">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,2">
               <StackPanel>
                <Grid>
                 <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="{Binding Key}"/>
                  <TextBlock FontSize="7" FontWeight="Bold" Foreground="{Binding UtilityBrushKey, Converter={StaticResource BrushKeyConverter}}" Margin="4,0,0,0" Text="{Binding UtilityBadge}" VerticalAlignment="Center"/>
                 </StackPanel>
                 <TextBlock FontSize="7" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right" Text="{Binding Ttl}"/>
                </Grid>
                <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="{Binding Value}"/>
               </StackPanel>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </DockPanel>
         </Border>
         <!-- Tier 2: Episodic Memory -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="1" Margin="0,0,6,0" Padding="8">
          <DockPanel LastChildFill="True">
