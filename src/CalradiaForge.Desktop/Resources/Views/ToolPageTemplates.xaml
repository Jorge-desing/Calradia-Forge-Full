           <Grid Margin="0,2,0,1">
            <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Workshop.SecurityScoreLabel}"/><Run Text=": 72.0 / 100"/></TextBlock>
