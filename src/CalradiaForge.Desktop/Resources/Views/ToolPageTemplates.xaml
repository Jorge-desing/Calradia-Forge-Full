            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{Binding KingdomDiplomacyDashboard.DynasticHeirScoreText}"/>
           </Border>
           <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1.5" CornerRadius="3" Padding="8,4">
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="{Binding KingdomDiplomacyDashboard.SenateChamberStatus}"/>
           </Border>
          </StackPanel>
         </Grid>
        </Border>
        <!-- Body: Faction Stances, Radar & Geopolitical Barometers -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
