            <Button Command="{Binding KingdomDiplomacyDashboard.ProposePeaceTreatyCommand}" Content="🕊️ Truce" FontSize="7.5" Padding="4,1" Margin="0,0,4,0"/>
            <TextBlock FontSize="8" Foreground="{Binding KingdomDiplomacyDashboard.SenateVoteBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Center">
             <Run Text="{Binding KingdomDiplomacyDashboard.SenateVoteOutcome, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KingdomDiplomacyDashboard.SimulatedSenateConsensus, Mode=OneWay}"/>
            </TextBlock>
           </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
