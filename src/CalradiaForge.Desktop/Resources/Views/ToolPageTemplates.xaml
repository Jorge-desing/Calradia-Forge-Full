              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </DockPanel>
         </Border>
         <!-- Tier 3: Procedural Memory -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="2" Padding="8">
          <DockPanel LastChildFill="True">
           <TextBlock DockPanel.Dock="Top" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,4" Text="{DynamicResource Viz.Memory.Procedural}"/>
