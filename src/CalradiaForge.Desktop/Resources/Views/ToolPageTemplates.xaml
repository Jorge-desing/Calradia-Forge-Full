                TickBrush="{DynamicResource MutedTextBrush}"
                MarkerBrush="{DynamicResource VerdigrisBrush}"
                LabelBrush="{DynamicResource PaperBrush}"
                MarkerLabel="SYNTHESIS"
                Height="32"
                Margin="0,4,0,0"/>
            <presentation:ForgeAreaChart
