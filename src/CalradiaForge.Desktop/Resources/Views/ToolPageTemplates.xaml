           <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,4">
            <Border Background="{DynamicResource BrassBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="92"/>
