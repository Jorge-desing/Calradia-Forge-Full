                 <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="{Binding Key}"/>
                  <TextBlock FontSize="7" FontWeight="Bold" Foreground="{Binding UtilityBrushKey, Converter={StaticResource BrushKeyConverter}}" Margin="4,0,0,0" Text="{Binding UtilityBadge}" VerticalAlignment="Center"/>
                 </StackPanel>
                 <TextBlock FontSize="7" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right" Text="{Binding Ttl}"/>
                </Grid>
                <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="{Binding Value}"/>
               </StackPanel>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </DockPanel>
         </Border>
