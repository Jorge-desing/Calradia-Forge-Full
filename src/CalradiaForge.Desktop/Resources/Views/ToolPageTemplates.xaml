<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation" xmlns:services="clr-namespace:CalradiaForge.Desktop.Services" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="TroopTreeVisualizerDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.crossed_swords}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{DynamicResource Viz.Troop.Title}" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding TroopTreeDashboard.Culture}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="22,1,0,0" Text="{Binding TroopTreeDashboard.ArchetypeSummary}"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding TroopTreeDashboard.StudioCaveat}" TextWrapping="Wrap"/>
           <StackPanel Orientation="Horizontal" Margin="22,3,0,0">
            <Button Command="{Binding TroopTreeDashboard.FilterArchetypeCommand}" CommandParameter="All" Content="All" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding TroopTreeDashboard.FilterArchetypeCommand}" CommandParameter="Infantry" Content="Inf" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding TroopTreeDashboard.FilterArchetypeCommand}" CommandParameter="Ranged" Content="Rng" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding TroopTreeDashboard.FilterArchetypeCommand}" CommandParameter="Cavalry" Content="Cav" FontSize="7.5" Padding="4,1" Margin="0,0,4,0"/>
            <Button Command="{Binding TroopTreeDashboard.SimulateBattleShockCommand}" Content="⚡ Shock" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding TroopTreeDashboard.ToggleCaptainPerksCommand}" Content="🎖️ Captain" FontSize="7.5" Padding="4,1" Margin="0,0,4,0"/>
            <TextBlock FontSize="8" Foreground="{DynamicResource VerdigrisBrush}" VerticalAlignment="Center">
             <Run Text="Cohesion: "/><Run Text="{Binding TroopTreeDashboard.SimulatedFrontlineCohesion, Mode=OneWay}"/><Run Text=" · Cost: "/><Run Text="{Binding TroopTreeDashboard.SimulatedArmyCostEstimate, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TroopTreeDashboard.PerkBonusSummary, Mode=OneWay}"/>
            </TextBlock>
           </StackPanel>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="3" Grid.Column="1" Padding="8,3" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Shield}" Height="12" Margin="0,0,4,0" Stretch="Uniform" Stroke="{DynamicResource BrassBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Width="12"/>
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{DynamicResource Viz.Troop.CountBadge}"/>
           </StackPanel>
          </Border>
         </Grid>
        </Border>
        <!-- Body: Troop Tree Branches -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
          <!-- Column: Levies (Tier I) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="175">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center" Text="{DynamicResource Viz.Troop.TierI}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6" Padding="6">
             <StackPanel>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Recruit"/>
               <Border Background="{DynamicResource DeepPineBrush}" CornerRadius="2" Grid.Column="1" Padding="3,1">
                <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="T1"/>
               </Border>
              </Grid>
              <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Troop.CommonLevies}"/><Run Text=" · "/><Run Text="{DynamicResource Viz.Troop.LevelShort}"/><Run Text=" 6"/></TextBlock>
              <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,3" Padding="0,3,0,0">
               <StackPanel>
                <Grid>
                 <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 100"/></TextBlock>
                 <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 2d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 20d"/></TextBlock>
                </Grid>
                <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,2,0,0">
                 <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="68"/>
                </Border>
               </StackPanel>
              </Border>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Troop.EquipmentLabel}"/><Run Text=": Spear, Sickle"/></TextBlock>
             </StackPanel>
            </Border>
            <TextBlock FontSize="9" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center"><Run Text="─────── ⯈ "/><Run Text="{DynamicResource Viz.Troop.Upgrades}"/></TextBlock>
           </StackPanel>
          </Border>
          <!-- Column: Core Line (Tier II-III) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="195">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Center" Text="{DynamicResource Viz.Troop.TierTwoThree}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,5" Padding="6">
             <StackPanel>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Infantryman [T2]"/>
               <Border Background="{DynamicResource DeepPineBrush}" CornerRadius="2" Grid.Column="1" Padding="3,1">
                <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="INF"/>
               </Border>
              </Grid>
              <Grid Margin="0,3,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 110"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 4d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 50d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,3">
               <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="76"/>
              </Border>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="⯈ Vet. Infantryman [T3] / Menavliaton"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="6">
             <StackPanel>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Archer [T2]"/>
               <Border Background="{DynamicResource DeepPineBrush}" CornerRadius="2" Grid.Column="1" Padding="3,1">
                <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="RNG"/>
               </Border>
              </Grid>
              <Grid Margin="0,3,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 100"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 4d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 50d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,3">
               <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="68"/>
              </Border>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Text="⯈ Vet. Archer [T3] / Crossbowman"/>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
          <!-- Column: Elite Veteran Branch (Tier IV) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8" Width="205">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="{DynamicResource Viz.Troop.TierFour}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="6">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Legionary"/>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,2,0,2" Padding="3,1">
               <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text="★ HEAVY SHIELDWALL"/>
              </Border>
              <Grid Margin="0,2,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 130"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 11d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 200d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4">
               <Border Background="{DynamicResource BrassBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="88"/>
              </Border>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="6">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Elite Menavliaton"/>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource EmberBrush}" BorderThickness="1" CornerRadius="2" Margin="0,2,0,2" Padding="3,1">
               <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource EmberBrush}" Text="★ ANTI-CAVALRY"/>
              </Border>
              <Grid Margin="0,2,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 125"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 11d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 200d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4">
               <Border Background="{DynamicResource EmberBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="84"/>
              </Border>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Padding="6">
             <StackPanel>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Palatine Guard"/>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Margin="0,2,0,2" Padding="3,1">
               <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="★ COMPOSITE BOW"/>
              </Border>
              <Grid Margin="0,2,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=": 120"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 11d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 200d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4">
               <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="80"/>
              </Border>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
          <!-- Column: Noble Dynastic Line (Tier II-VI) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="4" Padding="8" Width="215">
           <StackPanel>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="{DynamicResource Viz.Troop.NobleLine}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="5">
             <StackPanel>
              <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="Imperial Vigla Recruit [T2]"/>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" Text="⯈ Equite [T3] ⯈ Heavy Horseman [T4]"/>
             </StackPanel>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="3" Padding="6">
             <StackPanel>
              <StackPanel Orientation="Horizontal">
               <Path Data="{StaticResource GameIcon.knight_banner}" Fill="{DynamicResource BrassBrush}" Height="13" Margin="0,0,4,0" Stretch="Uniform" Width="13"/>
               <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="Imperial Elite Cataphract [T6]"/>
              </StackPanel>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,2,0,3" Padding="3,1">
               <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="★ BARDED WARHORSE &amp; LANCE"/>
              </Border>
              <Grid Margin="0,1,0,1">
               <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Troop.HpLabel}"/><Run Text=" 160 · "/><Run Text="{DynamicResource Viz.Troop.LevelShort}"/><Run Text=" 31"/></TextBlock>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Right"><Run Text="{DynamicResource Viz.Troop.WageLabel}"/><Run Text=" 24d · "/><Run Text="{DynamicResource Viz.Troop.CostLabel}"/><Run Text=" 450d"/></TextBlock>
              </Grid>
              <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,4">
               <Border Background="{DynamicResource BrassBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="108"/>
              </Border>
              <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Troop.ArmorLabel}"/><Run Text=": "/><Run Text="{DynamicResource Viz.Troop.HeadLabel}"/><Run Text=" 48 · "/><Run Text="{DynamicResource Viz.Troop.BodyLabel}"/><Run Text=" 68 · "/><Run Text="{DynamicResource Viz.Troop.LegLabel}"/><Run Text=" 44"/></TextBlock>
              <Grid Margin="0,2,0,0">
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="1" Grid.Column="0" Height="3" Margin="0,0,2,0"><Border Background="{DynamicResource TemperedBrush}" CornerRadius="1" Height="3" HorizontalAlignment="Left" Width="30"/></Border>
               <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="1" Grid.Column="1" Height="3" Margin="1,0,1,0"><Border Background="{DynamicResource BrassBrush}" CornerRadius="1" Height="3" HorizontalAlignment="Left" Width="44"/></Border>
               <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="1" Grid.Column="2" Height="3" Margin="2,0,0,0"><Border Background="{DynamicResource TemperedBrush}" CornerRadius="1" Height="3" HorizontalAlignment="Left" Width="28"/></Border>
              </Grid>
             </StackPanel>
            </Border>
           </StackPanel>
          </Border>
          <!-- Column: Tactical Combat Radar (5-Axis Vector Analysis) -->
          <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Width="200" Margin="0,0,4,0">
           <StackPanel>
            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6" Padding="4,1">
             <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="TACTICAL COMBAT RADAR" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4">
             <presentation:ForgeRadarChart
                 AxisLabels="{Binding TroopTreeDashboard.CombatRadarAxes}"
                 Values="{Binding TroopTreeDashboard.SelectedTroopRadarValues}"
                 ComparisonValues="{Binding TroopTreeDashboard.CaptainPerksRadarValues}"
                 Stroke="{DynamicResource BrassBrush}"
                 Fill="{DynamicResource BrassBrush}"
                 ComparisonStroke="{DynamicResource VerdigrisBrush}"
                 ComparisonFill="{DynamicResource VerdigrisBrush}"
                 GridBrush="{DynamicResource BorderBrush}"
                 AxisLabelBrush="{DynamicResource MutedTextBrush}"
                 Height="130" Width="175"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
             <Border Background="{DynamicResource BrassBrush}" Height="6" Width="6" CornerRadius="1" Margin="0,0,3,0"/>
             <TextBlock FontSize="7.5" Foreground="{DynamicResource BrassBrush}" Text="Standard" Margin="0,0,8,0"/>
             <Border Background="{DynamicResource VerdigrisBrush}" Height="6" Width="6" CornerRadius="1" Margin="0,0,3,0"/>
             <TextBlock FontSize="7.5" Foreground="{DynamicResource VerdigrisBrush}" Text="Captain Perks"/>
            </StackPanel>
            <TextBlock FontSize="7.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" Text="Pentagonal Shock &amp; Armor Geometry"/>
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </Grid></DataTemplate>
  <DataTemplate x:Key="AudioMixerInspectorDashboardTemplate"><Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GameIcon.gears}" Fill="{DynamicResource BrassBrush}" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
            <TextBlock FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{DynamicResource Viz.Audio.Title}" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock FontSize="10" Foreground="{DynamicResource PaperBrush}" Margin="22,2,0,0" Text="{Binding AudioStudioDashboard.AudioFormat}"/>
           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="22,1,0,0" Text="{Binding AudioStudioDashboard.DurationText}"/>
           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="22,2,0,0" Text="{Binding AudioStudioDashboard.StudioCaveat}" TextWrapping="Wrap"/>
           <StackPanel Orientation="Horizontal" Margin="22,3,0,0">
            <TextBlock FontSize="8" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,3,0" Text="Preset:"/>
            <Button Command="{Binding AudioStudioDashboard.ApplyPresetCommand}" CommandParameter="Flat" Content="Flat" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding AudioStudioDashboard.ApplyPresetCommand}" CommandParameter="Bass Boost" Content="Bass" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding AudioStudioDashboard.ApplyPresetCommand}" CommandParameter="Voice Clarity" Content="Voice" FontSize="7.5" Padding="4,1" Margin="0,0,2,0"/>
            <Button Command="{Binding AudioStudioDashboard.ApplyPresetCommand}" CommandParameter="Combat Punch" Content="Punch" FontSize="7.5" Padding="4,1" Margin="0,0,4,0"/>
            <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" VerticalAlignment="Center" Text="{Binding AudioStudioDashboard.ActivePreset, StringFormat='Active: {0}'}"/>
           </StackPanel>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="3" Grid.Column="1" Padding="8,3" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Shield}" Height="12" Margin="0,0,4,0" Stretch="Uniform" Stroke="{DynamicResource VerdigrisBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Width="12"/>
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="{DynamicResource Viz.Audio.NoClipping}"/>
           </StackPanel>
          </Border>
         </Grid>
        </Border>
        <!-- Body: Equalizer, Oscilloscope Waveform & VU Meters -->
        <Grid Grid.Row="1">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="185"/>
         </Grid.ColumnDefinitions>
         <!-- 5-Band Equalizer Spectrum -->
         <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Grid.Column="0" Margin="0,0,8,0" Padding="8">
          <StackPanel>
           <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Margin="0,0,0,6" Text="{DynamicResource Viz.Audio.Equalizer}"/>
           <ItemsControl ItemsSource="{Binding AudioStudioDashboard.Bands}">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Grid Margin="0,2">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
               </Grid.ColumnDefinitions>
               <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
               <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Grid.Column="1" Height="8" Margin="4,0" VerticalAlignment="Center">
                <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="8" HorizontalAlignment="Left" Width="{Binding Height}"/>
               </Border>
               <TextBlock FontSize="8" Foreground="{DynamicResource BrassBrush}" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Dbfs}" VerticalAlignment="Center"/>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
