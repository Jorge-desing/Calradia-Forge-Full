            <StackPanel>
             <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}"><Run Text="{DynamicResource Viz.Audio.HeadroomLabel}"/><Run Text=" +1.4 dB"/></TextBlock>
             <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}"><Run Text="{DynamicResource Viz.Audio.SpatialLabel}"/><Run Text=" 3D Mission"/></TextBlock>
