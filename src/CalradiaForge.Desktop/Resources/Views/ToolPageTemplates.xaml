            <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="4" Height="48" Margin="0,0,8,0" Width="48">

             <Image Focusable="False" Height="40" IsHitTestVisible="False" Opacity="0.94" Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/Optimized/evidence-ledger-empty-v1.png" Stretch="Uniform" Width="40">

              <Image.Visibility>

               <MultiBinding Converter="{StaticResource DecorativeAccentVisibilityConverter}" ConverterParameter="DecorativeTextureVisibility">

                <Binding Path="DataContext.DecorativeAccentsEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>

                <Binding Path="DataContext.ThemeId" RelativeSource="{RelativeSource AncestorType=Window}"/>

               </MultiBinding>

              </Image.Visibility>

             </Image>

            </Border>

            <StackPanel Grid.Column="1" MaxWidth="430" VerticalAlignment="Center">

             <TextBlock FontSize="{DynamicResource Token.HeadingFont}" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="{DynamicResource Ui.EmptyEvidence}" TextAlignment="Left" TextWrapping="Wrap"/>

             <Button AutomationProperties.AutomationId="EvidenceLedgerOpenPaletteButton" AutomationProperties.Name="{DynamicResource Ui.EmptyEvidenceAction}" Command="{Binding DataContext.OpenPaletteCommand, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{DynamicResource Token.LabelFont}" HorizontalAlignment="Left" Margin="0,3,0,0" MinHeight="32" Padding="6,3" Style="{StaticResource TacticalActionButton}" ToolTip="{DynamicResource Ui.EmptyEvidenceAction}">

              <TextBlock Text="{DynamicResource Ui.EmptyEvidenceAction}" TextAlignment="Center" TextWrapping="Wrap"/>

             </Button>

            </StackPanel>

           </Grid>

          </Border>

         </Grid>

        </Grid>

       </DockPanel>

      </Border>

     </TabItem>

     <TabItem AutomationProperties.AutomationId="WorkbenchRawResultTab" AutomationProperties.Name="{DynamicResource Ui.RawResult}" KeyboardNavigation.TabNavigation="Continue" Style="{StaticResource WorkbenchReportTabItem}">

      <TabItem.Header>

       <StackPanel Orientation="Horizontal">

        <Path Data="{StaticResource GameIcon.files}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Height="14" Margin="0,0,7,0" Stretch="Uniform" Width="14"/>

        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" FontSize="{DynamicResource Token.LabelFont}" FontWeight="Bold" Text="{DynamicResource Ui.RawResult}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>

       </StackPanel>

      </TabItem.Header>

      <Border Background="{DynamicResource DeepPineBrush}" Padding="{DynamicResource Token.Inset.Card}">

       <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">

         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

         <TextBlock Style="{StaticResource SectionHeading}" Text="{DynamicResource Ui.RawResult}"/>

        </Grid>

        <TextBox AcceptsReturn="True" AutomationProperties.AutomationId="RawResultText" AutomationProperties.Name="{DynamicResource Ui.RawResult}" FontFamily="Consolas" FontSize="{DynamicResource Token.CodeFont}" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" IsUndoEnabled="False" Text="{Binding RawResult, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

       </DockPanel>

      </Border>

     </TabItem>

    </TabControl>

    </Grid>

   </ScrollViewer>

  </DataTemplate>

 </ResourceDictionary>

