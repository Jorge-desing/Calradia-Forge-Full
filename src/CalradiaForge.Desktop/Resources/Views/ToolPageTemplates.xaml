           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
             <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{Binding TensionBrushKey, Converter={StaticResource BrushKeyConverter}}" BorderThickness="1.5" CornerRadius="4" Margin="0,0,6,6" Padding="6">
              <StackPanel>
               <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*"/>
                 <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Grid.Column="0" Text="{Binding FactionName}" TextTrimming="CharacterEllipsis"/>
                <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{Binding TensionBrushKey, Converter={StaticResource BrushKeyConverter}}" BorderThickness="1" CornerRadius="2" Grid.Column="1" Padding="3,1">
                 <TextBlock FontSize="7.5" FontWeight="Bold" Foreground="{Binding TensionBrushKey, Converter={StaticResource BrushKeyConverter}}" Text="{Binding Stance}"/>
                </Border>
               </Grid>
               <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{Binding TensionBrushKey, Converter={StaticResource BrushKeyConverter}}" Text="{Binding TensionText}"/>
               <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Height="8" Margin="0,3,0,3">
                <ProgressBar Background="Transparent" BorderThickness="0" Foreground="{Binding TensionBrushKey, Converter={StaticResource BrushKeyConverter}}" Maximum="100" Value="{Binding TensionLevel}"/>
               </Border>
               <TextBlock FontSize="7.5" Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource Viz.Diplomacy.BorderConflictRiskLabel}"/><Run Text=": "/><Run Text="{Binding BorderConflictProbability}"/><Run Text="%"/></TextBlock>
              </StackPanel>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Grid.Row="1" Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource SteelBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,2,6,0" Padding="6,3">
           <TextBlock FontSize="8" Foreground="{DynamicResource PaperBrush}" Text="{Binding KingdomDiplomacyDashboard.SelectedStanceDetails, Mode=OneWay}" TextWrapping="Wrap"/>
          </Border>
         </Grid>
         <!-- Right Column: Geopolitical Balance Radar & Senatorial Gauges -->
         <Border Grid.Column="1" Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
          <StackPanel>
           <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,4" Padding="4,1">
            <TextBlock FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" HorizontalAlignment="Center" Text="REALM POWER BALANCE"/>
           </Border>
           <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="2" Margin="0,0,0,4">
            <presentation:ForgeRadarChart
                AxisLabels="{Binding KingdomDiplomacyDashboard.DiplomaticRadarAxes}"
                Values="{Binding KingdomDiplomacyDashboard.FactionPowerRadarValues}"
                Stroke="{DynamicResource BrassBrush}"
                Fill="{DynamicResource BrassBrush}"
                GridBrush="{DynamicResource BorderBrush}"
                AxisLabelBrush="{DynamicResource MutedTextBrush}"
                Height="105" Width="195"/>
           </Border>
           <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Senate Consensus Gauge -->
            <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="0" Margin="0,0,3,0" Padding="3,2">
             <StackPanel HorizontalAlignment="Center">
              <presentation:ForgeRingGauge
                  Value="{Binding KingdomDiplomacyDashboard.SenateConsensusGaugeValue}"
                  Maximum="100"
                  Threshold="50"
                  CenterText="68%"
                  SubText="SENATE"
                  AccentBrush="{DynamicResource BrassBrush}"
                  BackgroundBrush="{DynamicResource CoalBrush}"
                  ThresholdBrush="{DynamicResource VerdigrisBrush}"
                  TextBrush="{DynamicResource PaperBrush}"
                  Height="46" Width="46"/>
             </StackPanel>
            </Border>
            <!-- War Risk Gauge -->
            <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="1" Margin="3,0,0,0" Padding="3,2">
             <StackPanel HorizontalAlignment="Center">
              <presentation:ForgeRingGauge
                  Value="{Binding KingdomDiplomacyDashboard.WarRiskGaugeValue}"
                  Maximum="100"
                  Threshold="60"
                  CenterText="24%"
                  SubText="WAR RISK"
                  AccentBrush="{DynamicResource EmberBrush}"
                  BackgroundBrush="{DynamicResource CoalBrush}"
                  ThresholdBrush="{DynamicResource EmberBrush}"
                  TextBrush="{DynamicResource PaperBrush}"
                  Height="46" Width="46"/>
             </StackPanel>
            </Border>
           </Grid>
          </StackPanel>
         </Border>
        </Grid></Grid></DataTemplate>
