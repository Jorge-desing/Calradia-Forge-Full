             <Run Text="{Binding AgentMemoryDashboard.FilteredFactsSummary, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AgentMemoryDashboard.ConsolidationFeedback, Mode=OneWay}"/>
            </TextBlock>
           </StackPanel>
          </StackPanel>
