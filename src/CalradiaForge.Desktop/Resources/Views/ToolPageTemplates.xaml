           <TextBlock FontSize="8.5" Foreground="{DynamicResource EmberBrush}" Margin="21,2,0,0" Text="{Binding KingdomDiplomacyDashboard.StudioCaveat}" TextWrapping="Wrap"/>
           <StackPanel Orientation="Horizontal" Margin="21,3,0,0">
