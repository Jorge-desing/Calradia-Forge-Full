           </Grid>
           <Border Background="{DynamicResource CoalBrush}" CornerRadius="2" Height="10" Margin="0,0,0,8">
            <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="10" HorizontalAlignment="Left" Width="128"/>
