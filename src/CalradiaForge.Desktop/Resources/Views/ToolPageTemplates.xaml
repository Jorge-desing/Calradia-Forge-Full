           <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Workshop.GarrisonLabel}"/><Run Text=": 165 Regulars"/></TextBlock>
