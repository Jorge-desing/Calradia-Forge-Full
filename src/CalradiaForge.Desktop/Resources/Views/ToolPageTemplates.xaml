            <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" HorizontalAlignment="Right" Text="+4.2/d ▲"/>
           </Grid>
           <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,4">
            <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="108"/>
           </Border>
           <Grid Margin="0,2,0,1">
            <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Viz.Workshop.CivicLoyaltyLabel}"/><Run Text=": 64.0 / 100"/></TextBlock>
           </Grid>
           <Border Background="{DynamicResource FrameSurfaceSolidBrush}" CornerRadius="2" Height="4" Margin="0,0,0,4">
