<UserControl x:Class="CalradiaForge.Desktop.Presentation.WorkbenchFooterControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
 xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 MinWidth="0" MinHeight="0">
<Border MinHeight="28" Padding="0,0,0,6">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="2,2,4,2" VerticalAlignment="Center">
    <TextBlock Text="Ctrl+K PALETTE" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}"/>
   </Border>
   <Button AutomationProperties.AutomationId="FooterPingButton" Command="{Binding PingConnectionCommand}" ToolTip="Ping IPC Session" Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource SteelBorderBrush}" BorderThickness="1" Padding="4,1" Margin="0,2,2,2" MinHeight="18" Height="18" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource VerdigrisBrush}"/>
     <TextBlock Text="{Binding ConnectionLatencyText, Mode=OneWay}" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
    </StackPanel>
   </Button>
  </StackPanel>
  <TextBlock AutomationProperties.AutomationId="KeyboardShortcutHint" Grid.Column="1" FontSize="{DynamicResource Token.LabelFont}" Foreground="{DynamicResource MutedTextBrush}" Margin="8,2,8,2" MinHeight="18" Text="{DynamicResource Ui.ShortcutHint}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
  <Border Grid.Column="2" Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,2,2,2" VerticalAlignment="Center">
   <TextBlock Text="Ctrl+D SPLIT" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}"/>
  </Border>
 </Grid>
</Border>
</UserControl>
