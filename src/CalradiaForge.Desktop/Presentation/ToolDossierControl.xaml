<UserControl x:Class="CalradiaForge.Desktop.Presentation.ToolDossierControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
 xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 MinWidth="0" MinHeight="0">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
<Border AutomationProperties.AutomationId="SectionDossierCard" Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{Binding Tool.CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="10,8">
       <StackPanel>
        <Grid Margin="0,0,0,6">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" VerticalAlignment="Center">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Path Data="{StaticResource GameIcon.scroll_unfurled}" Fill="{Binding Tool.CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" Height="13" Margin="0,0,7,0" Stretch="Uniform" VerticalAlignment="Center" Width="13"/>
         <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Grid.Column="1" Text="{DynamicResource Ui.DossierHeading}" TextWrapping="Wrap" VerticalAlignment="Center"/>
         <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{Binding Tool.CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" BorderThickness="1" CornerRadius="3" Grid.Column="2" Margin="8,0,0,0" Padding="5,1" VerticalAlignment="Center">
          <TextBlock FontSize="9" FontWeight="Bold" Foreground="{Binding Tool.CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" Text="{Binding Tool.Group}"/>
         </Border>
        </Grid>
         <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="1" Padding="6,2" VerticalAlignment="Center">
          <TextBlock FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource Ui.RuntimeLabel}"/>
         </Border>
        </Grid>

        <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6" Padding="8,5">
         <TextBlock FontSize="10.5" Foreground="{DynamicResource PaperBrush}" LineHeight="16" Text="{Binding Tool.SectionInformation}" TextWrapping="Wrap"/>
        </Border>

        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>

         <!-- Left: In-Game Console Commands -->
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="0" Padding="7,5">
          <StackPanel>
           <TextBlock Margin="0,0,0,4" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.ConsoleCommandsHeading}" TextWrapping="Wrap"/>
           <ItemsControl ItemsSource="{Binding ConsoleCommandEntries}">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,1,0,2" Padding="5,2">
               <Grid>
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*"/>
                 <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                 <TextBlock FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="$ " VerticalAlignment="Center"/>
                 <TextBlock FontFamily="Consolas, monospace" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <Button AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Text}" Grid.Column="1" Height="18" Margin="4,0,0,0" Style="{StaticResource SearchClearButton}" ToolTip="{DynamicResource Ui.CopyCommandToolTip}" Width="18">
                 <Path Data="{StaticResource Icon.File}" Height="9" Stretch="Uniform" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="9"/>
                </Button>
               </Grid>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </Border>

         <!-- Right: Hotkeys & CLI -->
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Grid.Column="2" Padding="7,5">
          <StackPanel>
           <TextBlock Margin="0,0,0,3" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.AvailableShortcutsHeading}" TextWrapping="Wrap"/>
           <ItemsControl ItemsSource="{Binding ApplicableHotkeys}">
            <ItemsControl.ItemsPanel>
             <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,3,2" Padding="4,1">
               <TextBlock FontSize="9" Foreground="{DynamicResource PaperBrush}" Text="{Binding}"/>
              </Border>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>

           <TextBlock Margin="0,3,0,2" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.CliInvocationHeading}" TextWrapping="Wrap"/>
           <Border Background="{DynamicResource RailSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2">
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
             </Grid.ColumnDefinitions>
             <TextBlock FontFamily="Consolas, monospace" FontSize="9.5" Foreground="{DynamicResource BrassBrush}" Grid.Column="0" Text="{Binding CliSyntax}" TextWrapping="Wrap" VerticalAlignment="Center"/>
             <Button AutomationProperties.AutomationId="CopyCliSyntaxButton" AutomationProperties.Name="{DynamicResource Ui.CopyCliAccessibleName}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding CliSyntax}" Grid.Column="1" Height="18" Margin="4,0,0,0" Style="{StaticResource SearchClearButton}" ToolTip="{DynamicResource Ui.CopyCliToolTip}" Width="18">
              <Path Data="{StaticResource Icon.File}" Height="9" Stretch="Uniform" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="9"/>
             </Button>
            </Grid>
           </Border>
          </StackPanel>
         </Border>
        </Grid>
        <TextBlock AutomationProperties.AutomationId="ClipboardCopyFeedback" AutomationProperties.LiveSetting="Polite" FontSize="9" Foreground="{DynamicResource EmberBrush}" Margin="0,5,0,0" Text="{Binding CopyFeedback}" TextWrapping="Wrap"/>

        <!-- Imperial Wax Seal Stateless Certification Badge (Rev085) -->
        <Border AutomationProperties.AutomationId="DossierStatelessCertificationBadge" Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="8,5">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image AutomationProperties.AutomationId="ImperialWaxSealImage" Focusable="False" Height="36" IsHitTestVisible="False" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/imperial-wax-seal-rev085.png" Stretch="Uniform" VerticalAlignment="Center" Width="36"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="CERTIFIED STATELESS · SANDBOX SECURE"/>
           <TextBlock FontSize="7.5" Foreground="{DynamicResource PaperBrush}" Text="Zero SaveableTypeDefiner · In-memory isolation · Calradia Forge Core SDK"/>
          </StackPanel>
          <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Grid.Column="2" Padding="6,2" VerticalAlignment="Center">
           <TextBlock FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="IMPERIAL AUDIT PASSED"/>
          </Border>
         </Grid>
        </Border>
       </StackPanel>
      </Border>
</ScrollViewer>
</UserControl>
