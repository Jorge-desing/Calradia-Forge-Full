<UserControl x:Class="CalradiaForge.Desktop.Presentation.CommandPaletteControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
 xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 MinWidth="0" MinHeight="0">
<Border AutomationProperties.AutomationId="CommandPaletteOverlay" Background="#E60D1714" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="4" Padding="28" Panel.ZIndex="20" Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" HorizontalAlignment="Center" MaxHeight="610" MaxWidth="760" Padding="20" VerticalAlignment="Center">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal">
           <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1.5" CornerRadius="3" Margin="0,0,9,0" Padding="2" Width="36" Height="36" VerticalAlignment="Center" ToolTip="Calradia Imperial Tactical Command Palette — Quick Tool Dispatch">
            <Image Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/calradia-astrolabe-dial-rev086.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
           </Border>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{DynamicResource Ui.CommandPalette}" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="8,0,0,0" Padding="5,2" VerticalAlignment="Center">
           <TextBlock FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="194 TOOLS"/>
          </Border>
         </StackPanel>
         <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,6" Text="{DynamicResource Ui.SearchHint}" TextWrapping="Wrap"/>
         <!-- Quick Prefix Selector Chips -->
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="ALL"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text=">live"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text=">diag"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text=">asset"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text=">sim"/>
          </Border>
         </StackPanel>
        </StackPanel>
        <Button AutomationProperties.AutomationId="CloseCommandPaletteButton" AutomationProperties.Name="{DynamicResource Ui.Close}" Command="{Binding ClosePaletteCommand}" Content="{DynamicResource Ui.Close}" Grid.Column="1" MinHeight="34" MinWidth="72" Padding="8,4" VerticalAlignment="Top"/>
       </Grid>
       <TextBox AutomationProperties.AutomationId="CommandPaletteSearch" AutomationProperties.Name="{DynamicResource Ui.Search}" MinHeight="42" Padding="12,6" Text="{Binding PaletteFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Ui.Search}" VerticalContentAlignment="Center">
        <TextBox.InputBindings>
         <KeyBinding Command="{Binding SelectFirstPaletteToolCommand}" Key="Return"/>
        </TextBox.InputBindings>
       </TextBox>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,2" CornerRadius="2" Padding="6,2" Margin="0,0,6,0">
          <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="↑↓ NAVIGATE"/>
         </Border>
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1,1,1,2" CornerRadius="2" Padding="6,2" Margin="0,0,6,0">
          <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="↵ SELECT"/>
         </Border>
         <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,2" CornerRadius="2" Padding="6,2">
          <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" Text="ESC DISMISS"/>
         </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Text="CALRADIA FORGE WORKBENCH · " VerticalAlignment="Center"/>
         <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource VerdigrisBrush}" Text="STANDALONE PE" VerticalAlignment="Center"/>
        </StackPanel>
       </Grid>
      </Border>
      <ListBox AutomationProperties.AutomationId="CommandPaletteToolList" AutomationProperties.Name="{DynamicResource Ui.CommandPalette}" Background="Transparent" BorderThickness="0" ItemsSource="{Binding PaletteTools}" Margin="0,12,0,0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedTool}" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,1,0,3" Padding="6,5">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
           </Grid.ColumnDefinitions>
           <Border Grid.Column="0" Background="{Binding CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" CornerRadius="2" Margin="0,1,6,1" VerticalAlignment="Stretch"/>
           <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal">
             <Ellipse Width="6" Height="6" Fill="{Binding CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
             <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="{Binding Title}"/>
             <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="8,0,0,0" Padding="5,1" VerticalAlignment="Center">
              <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{Binding CategoryAccentBrushKey, Converter={StaticResource BrushKeyConverter}}" Text="{Binding Group}"/>
             </Border>
            </StackPanel>
            <TextBlock FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" Margin="12,2,0,0" Text="{Binding Id}"/>
           </StackPanel>
           <Border Grid.Column="2" Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{Binding KindLabel}"/>
           </Border>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Border>
</UserControl>
