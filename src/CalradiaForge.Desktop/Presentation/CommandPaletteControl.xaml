<UserControl x:Class="CalradiaForge.Desktop.Presentation.CommandPaletteControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
 xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 MinWidth="0" MinHeight="0">
<Border AutomationProperties.AutomationId="CommandPaletteOverlay" Background="#E60D1714" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="4" Padding="28" Panel.ZIndex="20" Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Background="{DynamicResource DeepPineBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" HorizontalAlignment="Center" MaxHeight="610" MaxWidth="760" Padding="20" VerticalAlignment="Center">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Image Height="16" Margin="0,0,7,0" Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/calradia-astrolabe-dial-rev086.png" Stretch="Uniform" VerticalAlignment="Center" Width="16"/>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{DynamicResource Ui.CommandPalette}" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="8,0,0,0" Padding="4,1" VerticalAlignment="Center">
           <TextBlock FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="194 TOOLS"/>
          </Border>
         </StackPanel>
         <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,6" Text="{DynamicResource Ui.SearchHint}" TextWrapping="Wrap"/>
         <!-- Quick Prefix Selector Chips -->
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="ALL"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource VerdigrisBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource VerdigrisBrush}" Text=">live"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource BrassBrush}" Text=">diag"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text=">asset"/>
          </Border>
          <Border Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1">
           <TextBlock FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text=">sim"/>
          </Border>
         </StackPanel>
        </StackPanel>
        <Button AutomationProperties.AutomationId="CloseCommandPaletteButton" AutomationProperties.Name="{DynamicResource Ui.Close}" Command="{Binding ClosePaletteCommand}" Content="{DynamicResource Ui.Close}" Grid.Column="1" MinHeight="34" MinWidth="72" Padding="8,4" VerticalAlignment="Top"/>
       </Grid>
       <TextBox AutomationProperties.AutomationId="CommandPaletteSearch" AutomationProperties.Name="{DynamicResource Ui.Search}" MinHeight="42" Padding="12,6" Text="{Binding PaletteFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Ui.Search}" VerticalContentAlignment="Center">
        <TextBox.InputBindings>
         <KeyBinding Command="{Binding SelectFirstPaletteToolCommand}" Key="Return"/>
        </TextBox.InputBindings>
       </TextBox>
      </StackPanel>
      <ListBox AutomationProperties.AutomationId="CommandPaletteToolList" AutomationProperties.Name="{DynamicResource Ui.CommandPalette}" Background="Transparent" BorderThickness="0" ItemsSource="{Binding PaletteTools}" Margin="0,12,0,0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedTool}" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <StackPanel Orientation="Horizontal">
             <Ellipse Width="6" Height="6" Fill="{DynamicResource VerdigrisBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
             <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="{Binding Title}"/>
            </StackPanel>
            <TextBlock FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" Margin="12,2,0,0" Text="{Binding Id}"/>
           </StackPanel>
           <Border Grid.Column="1" Background="{DynamicResource CoalBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="{Binding KindLabel}"/>
           </Border>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Border>
</UserControl>
