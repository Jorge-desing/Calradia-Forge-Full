<UserControl x:Class="CalradiaForge.Desktop.Presentation.WorkbenchStatusControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
 xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 MinWidth="0" MinHeight="0">
 <Border AutomationProperties.AutomationId="WorkOrderCards" Margin="0,6,0,8">
  <WrapPanel>
   <Border AutomationProperties.AutomationId="WorkOrderContextStatus" Margin="0,0,6,0" MinWidth="0" Style="{StaticResource OrderCard}" ToolTip="{Binding WorkOrderContext}" Width="178">
    <Grid>
     <Path Data="{StaticResource GameIcon.compass}" Fill="{DynamicResource BrassBrush}" Focusable="False" Height="14" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="{DynamicResource Token.StatusIconOpacity}" Stretch="Uniform" VerticalAlignment="Top" Width="14"/>
     <StackPanel Margin="0,0,16,0">
      <TextBlock FontSize="{DynamicResource Token.LabelFont}" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.Context}" TextWrapping="Wrap"/>
      <TextBlock FontSize="12" Style="{StaticResource OrderValue}" Text="{Binding WorkOrderContext}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding WorkOrderContext}"/>
     </StackPanel>
     <Border Background="{DynamicResource BrassBrush}" CornerRadius="0,0,3,3" Height="2" HorizontalAlignment="Stretch" Opacity="0.45" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
   <Border AutomationProperties.AutomationId="WorkOrderPermissionStatus" Margin="6,0" MinWidth="0" Style="{StaticResource OrderCard}" ToolTip="{Binding TestingPermission}" Width="178">
    <Grid>
     <Path Data="{StaticResource GameIcon.eye_target}" Fill="{DynamicResource BrassBrush}" Focusable="False" Height="14" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="{DynamicResource Token.StatusIconOpacity}" Stretch="Uniform" VerticalAlignment="Top" Width="14"/>
     <StackPanel Margin="0,0,16,0">
      <TextBlock FontSize="{DynamicResource Token.LabelFont}" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.TestPermission}" TextWrapping="Wrap"/>
      <TextBlock FontSize="12" Style="{StaticResource OrderValue}" Text="{Binding TestingPermission}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding TestingPermission}"/>
     </StackPanel>
     <Border Background="{DynamicResource VerdigrisBrush}" CornerRadius="0,0,3,3" Height="2" HorizontalAlignment="Stretch" Opacity="0.45" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
   <Border AutomationProperties.AutomationId="WorkOrderReportStatus" Margin="6,0" MinWidth="0" Style="{StaticResource OrderCard}" ToolTip="{Binding ReportState}" Width="178">
    <Grid>
     <Path Data="{StaticResource GameIcon.histogram}" Fill="{DynamicResource BrassBrush}" Focusable="False" Height="14" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="{DynamicResource Token.StatusIconOpacity}" Stretch="Uniform" VerticalAlignment="Top" Width="14"/>
     <StackPanel Margin="0,0,16,0">
      <TextBlock FontSize="{DynamicResource Token.LabelFont}" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.ReportState}" TextWrapping="Wrap"/>
      <TextBlock FontSize="12" Style="{StaticResource OrderValue}" Text="{Binding ReportState}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding ReportState}"/>
     </StackPanel>
     <Border Background="{DynamicResource BrassBrush}" CornerRadius="0,0,3,3" Height="2" HorizontalAlignment="Stretch" Opacity="0.45" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
   <Border AutomationProperties.AutomationId="WorkOrderApplicationStatus" AutomationProperties.Name="{Binding ActiveRouteStatus}" Margin="6,0" MinWidth="0" Style="{StaticResource OrderCard}" ToolTip="{Binding ActiveRouteStatus}" Width="178">
    <Grid>
     <Path Data="{StaticResource GameIcon.gears}" Fill="{DynamicResource BrassBrush}" Focusable="False" Height="14" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="{DynamicResource Token.StatusIconOpacity}" Stretch="Uniform" VerticalAlignment="Top" Width="14"/>
     <StackPanel Margin="0,0,16,0">
      <TextBlock FontSize="{DynamicResource Token.LabelFont}" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.ActiveTool}" TextWrapping="Wrap"/>
      <TextBlock AutomationProperties.AutomationId="ActiveRouteStatusText" MaxHeight="42" FontSize="12" Style="{StaticResource OrderValue}" Text="{Binding ActiveRouteStatus}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding ActiveRouteStatus}"/>
      <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}" Text="{Binding ThemeMessage}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTip="{Binding ThemeMessage}">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Visibility" Value="Visible"/>
         <Style.Triggers><DataTrigger Binding="{Binding ThemeMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     </StackPanel>
     <Border Background="{DynamicResource EmberBrush}" CornerRadius="0,0,3,3" Height="2" HorizontalAlignment="Stretch" Opacity="0.45" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
   <Border AutomationProperties.AutomationId="RetainedEvidenceSummary" Margin="6,0,0,0" MinWidth="0" Style="{StaticResource OrderCard}" Width="178">
    <Grid>
     <Path Data="{StaticResource GameIcon.files}" Fill="{DynamicResource BrassBrush}" Focusable="False" Height="14" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="{DynamicResource Token.StatusIconOpacity}" Stretch="Uniform" VerticalAlignment="Top" Width="14"/>
     <StackPanel Margin="0,0,16,0">
      <TextBlock FontSize="{DynamicResource Token.LabelFont}" Style="{StaticResource KickerText}" Text="{DynamicResource Ui.RetainedEvidence}" TextWrapping="Wrap"/>
      <Grid Margin="0,2,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="{Binding EvidenceSummary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding EvidenceSummary}" VerticalAlignment="Center"/>
       <Button AutomationProperties.AutomationId="ExportEvidenceButton" AutomationProperties.Name="{DynamicResource Ui.ExportEvidence}" Command="{Binding ExportEvidenceCommand}" Grid.Column="1" Height="30" Margin="3,0,0,0" MinHeight="30" Padding="6,4" Style="{StaticResource TacticalActionButton}" ToolTip="{DynamicResource Ui.ExportEvidence}" Width="36">
        <Path Data="{StaticResource GameIcon.files}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Focusable="False" Height="15" IsHitTestVisible="False" Stretch="Uniform" Width="15"/>
       </Button>
      </Grid>
     </StackPanel>
     <Border Background="{DynamicResource BrassBrush}" CornerRadius="0,0,3,3" Height="2" HorizontalAlignment="Stretch" Opacity="0.45" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
  </WrapPanel>
 </Border>
</UserControl>
