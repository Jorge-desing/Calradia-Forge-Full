<Window x:Class="CalradiaForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CalradiaForge.Desktop.Services"
        xmlns:presentation="clr-namespace:CalradiaForge.Desktop.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Calradia Forge 25.2.0" Width="1360" Height="820" MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource CoalBrush}" Foreground="{DynamicResource PaperBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" Closed="Window_Closed">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Resources/Views/ToolPageTemplates.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
  <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
  <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunPrimaryCommand}"/>
  <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}"/>
  <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="0"/>
  <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="1"/>
  <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="2"/>
  <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="3"/>
  <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="4"/>
  <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="5"/>
  <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="6"/>
  <KeyBinding Key="D8" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="7"/>
  <KeyBinding Key="D9" Modifiers="Control" Command="{Binding SelectPinnedSlotCommand}" CommandParameter="8"/>
  <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleSplitDeckCommand}"/>
 </Window.InputBindings>
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="{DynamicResource Token.CaptionHeight}" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBarBorder" Grid.Row="0" Height="{DynamicResource Token.CaptionHeight}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" ClipToBounds="True" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="Background" Value="{DynamicResource TitleBarSurfaceBrush}"/>
     <Style.Triggers><DataTrigger Binding="{Binding DecorativeAccentsEnabled}" Value="False"><Setter Property="Background" Value="{DynamicResource TitleBarSurfaceSolidBrush}"/></DataTrigger></Style.Triggers>
    </Style>
   </Border.Style>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="{StaticResource TitleBarCartographicBandBrush}" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
     <Border.Visibility><MultiBinding Converter="{StaticResource DecorativeAccentVisibilityConverter}" ConverterParameter="DecorativeTextureVisibility"><Binding Path="DecorativeAccentsEnabled"/><Binding Path="ThemeId"/></MultiBinding></Border.Visibility>
    </Border>
    <Image Grid.Column="0" Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/Optimized/titlebar-heraldic-corner.png" Width="34" Height="34" Stretch="Uniform" Opacity="0.78" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
     <Image.Visibility><MultiBinding Converter="{StaticResource DecorativeAccentVisibilityConverter}" ConverterParameter="TitleBarHeraldicMarkVisibility"><Binding Path="DecorativeAccentsEnabled"/><Binding Path="ThemeId"/></MultiBinding></Image.Visibility>
    </Image>
    <Image AutomationProperties.AutomationId="ParchmentTitleBarJournalMark" Grid.Column="0" Source="pack://application:,,,/CalradiaForge.Desktop;component/Resources/Textures/Optimized/parchment-field-journal-ornament-v1.png" Width="30" Height="30" Stretch="Uniform" Opacity="0.86" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
     <Image.Visibility><MultiBinding Converter="{StaticResource DecorativeAccentVisibilityConverter}" ConverterParameter="TitleBarJournalMarkVisibility"><Binding Path="DecorativeAccentsEnabled"/><Binding Path="ThemeId"/></MultiBinding></Image.Visibility>
    </Image>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource Ui.AppTitle}" Foreground="{DynamicResource PaperBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
     <Border Background="{DynamicResource FrameSurfaceSolidBrush}" BorderBrush="{DynamicResource BrassBrush}" BorderThickness="1" CornerRadius="2" Margin="10,0,0,0" Padding="5,1" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource BrassBrush}" Text="v25.2.0 · BANNERLORD PRO"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
     <Button AutomationProperties.AutomationId="WindowMinimizeButton" AutomationProperties.Name="{DynamicResource Ui.WindowMinimize}" ToolTip="{DynamicResource Ui.WindowMinimize}" Style="{StaticResource TitleBarCaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Window_MinimizeClick" TabIndex="0">
      <Path Data="M2,8 L10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
     </Button>
     <Button AutomationProperties.AutomationId="WindowMaximizeButton" AutomationProperties.Name="{DynamicResource Ui.WindowMaximize}" ToolTip="{DynamicResource Ui.WindowMaximize}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Window_MaximizeClick" TabIndex="1">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleBarCaptionButton}"><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <Path Data="M2,2 H10 V10 H2 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
     </Button>
     <Button AutomationProperties.AutomationId="WindowRestoreButton" AutomationProperties.Name="{DynamicResource Ui.WindowRestore}" ToolTip="{DynamicResource Ui.WindowRestore}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Window_RestoreClick" TabIndex="2">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleBarCaptionButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <Path Data="M3,2 H10 V9 H3 Z M1,4 V11 H8" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="13" Height="13" Stretch="Uniform"/>
     </Button>
     <Button AutomationProperties.AutomationId="WindowCloseButton" AutomationProperties.Name="{DynamicResource Ui.WindowClose}" ToolTip="{DynamicResource Ui.WindowClose}" Style="{StaticResource TitleBarCloseButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Window_CloseClick" TabIndex="3">
      <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
     </Button>
    </StackPanel>
   </Grid>
  </Border>
  <presentation:WorkbenchShellView Grid.Row="1"/>
 </Grid>
</Window>
