    <Resource Include="Resources/Textures/Optimized/titlebar-embroidered-cloth.png" />
    <Resource Include="Resources/Textures/Optimized/titlebar-botanical-band-v1.png" />
    <Resource Include="Resources/Textures/Optimized/titlebar-cartographic-panorama-rev072.png" />
    <Resource Include="Resources/Textures/Optimized/titlebar-heraldic-corner.png" />
    <Resource Include="Resources/Textures/Optimized/header-heraldic-compass-v2.png" />
    <Resource Include="Resources/Textures/Optimized/header-corner-engraving-v1.png" />
    <Resource Include="Resources/Textures/Optimized/evidence-ledger-empty-v1.png" />
    <Resource Include="Resources/Textures/Optimized/rail-field-compass-v1.png" />
    <Resource Include="Resources/Textures/Optimized/parchment-field-journal-ornament-v1.png" />
