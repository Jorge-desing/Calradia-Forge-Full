<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseAppHost>false</UseAppHost>
    <ApplicationIcon>../../assets/calradia-forge.ico</ApplicationIcon>
    <Company>Calradia Forge Team</Company>
    <Product>Calradia Forge Desktop</Product>
    <Description>Standalone companion for verified Calradia Forge developer tooling.</Description>
    <Copyright>Copyright (c) 2026 Calradia Forge Team</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CalradiaForge.Core/CalradiaForge.Core.csproj" />
    <None Remove="Resources/Textures/**/*.png" />
