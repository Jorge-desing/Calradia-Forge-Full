<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CalradiaForge.ContentShowcase</AssemblyName>
    <RootNamespace>CalradiaForge.ContentShowcase</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\modules\CalradiaForgeContentShowcase\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/CalradiaForge.Sdk/CalradiaForge.Sdk.csproj" Private="false" />
    <Reference Include="$(GameBin)\TaleWorlds.MountAndBlade.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameBin)\TaleWorlds.Library.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameBin)\TaleWorlds.Localization.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
